---
import DayCell from './DayCell.astro';
import { buildCalendar } from '../lib/calendar';
import { pathFor, type Lang } from '../lib/i18n';
import type { Day } from '../lib/content';

interface Props {
  lang: Lang;
  startDate: string;
  endDate: string;
  timeZone: string;
  days: Day[];
}

const { lang, startDate, endDate, timeZone, days } = Astro.props;
const base = import.meta.env.BASE_URL;
const calendar = buildCalendar(
  startDate,
  endDate,
  days.map((d) => ({ id: d.id, ...d.data })),
);
---

<div class="calendar" data-calendar data-tz={timeZone}>
  {
    calendar.map((d) => (
      <DayCell
        lang={lang}
        date={d.date}
        weekday={d.weekday}
        activity={d.day?.activity?.[lang] ?? d.day?.activity?.es}
        href={d.day?.session ? pathFor(lang, `/sessions/${d.day.session}/`, base) : undefined}
      />
    ))
  }
</div>

<script>
  import { dayState, todayIn } from '../lib/calendar';

  // "Today" depends on when the page is viewed, so it is computed in the browser.
  for (const cal of document.querySelectorAll<HTMLElement>('[data-calendar]')) {
    const today = todayIn(cal.dataset.tz ?? 'UTC');
    for (const cell of cal.querySelectorAll<HTMLElement>('[data-date]')) {
      const state = dayState(cell.dataset.date ?? '', today);
      cell.dataset.state = state;
      if (state === 'today') {
        cell.setAttribute('aria-current', 'date');
        cal.scrollLeft = cell.offsetLeft - (cal.clientWidth - cell.clientWidth) / 2;
      }
    }
  }
</script>

<style>
  .calendar {
    position: relative;
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    padding: var(--s-1) var(--s-1) var(--s-3);
    scroll-snap-type: x proximity;
  }
  .calendar > :global(*) {
    scroll-snap-align: center;
  }
</style>
