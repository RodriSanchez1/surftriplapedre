---
import DayCell from './DayCell.astro';
import { buildCalendar } from '../lib/calendar';
import { pathFor, type Lang } from '../lib/i18n';
import type { Dia } from '../lib/content';

interface Props {
  lang: Lang;
  inicio: string;
  fin: string;
  zonaHoraria: string;
  dias: Dia[];
}

const { lang, inicio, fin, zonaHoraria, dias } = Astro.props;
const base = import.meta.env.BASE_URL;
const days = buildCalendar(
  inicio,
  fin,
  dias.map((d) => ({ id: d.id, ...d.data })),
);
---

<div class="calendar" data-calendar data-tz={zonaHoraria}>
  {
    days.map((d) => (
      <DayCell
        lang={lang}
        fecha={d.fecha}
        weekday={d.weekday}
        actividad={d.dia?.actividad?.[lang] ?? d.dia?.actividad?.es}
        href={d.dia?.sesion ? pathFor(lang, `/sesiones/${d.dia.sesion}/`, base) : undefined}
      />
    ))
  }
</div>

<script>
  import { dayState, todayIn } from '../lib/calendar';

  // "Hoy" depende de cuándo se mira la página, así que se calcula en el navegador.
  for (const cal of document.querySelectorAll<HTMLElement>('[data-calendar]')) {
    const today = todayIn(cal.dataset.tz ?? 'UTC');
    for (const cell of cal.querySelectorAll<HTMLElement>('[data-fecha]')) {
      const state = dayState(cell.dataset.fecha ?? '', today);
      cell.dataset.state = state;
      if (state === 'today') {
        cell.setAttribute('aria-current', 'date');
        cal.scrollLeft = cell.offsetLeft - (cal.clientWidth - cell.clientWidth) / 2;
      }
    }
  }
</script>

<style>
  .calendar {
    position: relative;
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    padding: var(--s-1) var(--s-1) var(--s-3);
    scroll-snap-type: x proximity;
  }
  .calendar > :global(*) {
    scroll-snap-align: center;
  }
</style>
