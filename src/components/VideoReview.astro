---
/**
 * The coach's video review: clips from disk, a player, drawing on the paused frame and captures.
 * An app screen: the page does not scroll. The parent gives it a box (the app shell in BaseLayout, or a
 * fixed-height frame on /design/) and the video takes what the controls leave. The client logic is in
 * src/lib/review/page.ts. With `demo` a filled-in state is shown and the script leaves it alone; with
 * `demo="login"`, the Google login that covers the screen until the coach signs in (only when Drive is set up).
 */
import { dayMonth, weekdayOf } from '../lib/calendar';
import { WEEKDAYS, format, t, type Lang } from '../lib/i18n';
import type { Texts } from '../lib/review/page';
import AudioUploader from './AudioUploader.astro';
import Avatar from './Avatar.astro';
import TourOverlay from './TourOverlay.astro';
import ToolIcon from './ToolIcon.astro';

interface Props {
  lang: Lang;
  dates: string[];
  timeZone: string;
  spots?: string[];
  surfers: { id: string; name: string; color: string }[];
  audio?: { driveFolder: string; googleClientId: string; contact: string };
  demo?: boolean | 'login' | 'pending';
}

const { lang, dates, timeZone, spots = [], surfers, audio, demo: demoProp = false } = Astro.props;
const gated = audio !== undefined && (demoProp === 'login' || !demoProp);
const demo = demoProp !== false;
const demoPending = demoProp === 'pending';
const texts: Texts = {
  reopen: t(lang, 'review.reopen'),
  noVideos: t(lang, 'review.noVideos'),
  unplayable: t(lang, 'review.unplayable'),
  approx: t(lang, 'review.approx'),
  captureTagged: t(lang, 'review.captureTagged'),
  captureUntagged: t(lang, 'review.captureUntagged'),
  openCapture: t(lang, 'review.openCapture'),
  clipTagged: t(lang, 'review.clipTagged'),
  deleteCapture: t(lang, 'review.deleteCapture'),
  deleteCaptureConfirm: t(lang, 'review.deleteCaptureConfirm'),
  finishCount: t(lang, 'review.finishCount'),
  sessionLocked: t(lang, 'review.sessionLocked'),
  restored: t(lang, 'review.restored'),
  discardConfirm: t(lang, 'review.discardConfirm'),
  nothing: t(lang, 'review.nothing'),
  uploading: t(lang, 'review.uploading'),
  done: t(lang, 'review.done'),
  errorUpload: t(lang, 'review.errorUpload'),
  errorPermission: format(t(lang, 'audio.errorPermission'), { contact: audio?.contact ?? '' }),
  errorLogin: t(lang, 'audio.errorLogin'),
  whoSurfs: t(lang, 'review.whoSurfs'),
  tags: t(lang, 'review.tags'),
  willDelete: t(lang, 'review.willDelete'),
  kindNames: {
    landscape: t(lang, 'review.kindLandscape'),
    extras: t(lang, 'review.kindExtras'),
    delete: t(lang, 'review.kindDelete'),
  },
  keep: t(lang, 'review.keep'),
  upload: t(lang, 'review.upload'),
  uploadAndDelete: t(lang, 'review.uploadAndDelete'),
  uploadAndDeleteOne: t(lang, 'review.uploadAndDeleteOne'),
  deleteWarn: t(lang, 'review.deleteWarn'),
  deleteCant: t(lang, 'review.deleteCant'),
  doneDeleted: t(lang, 'review.doneDeleted'),
  doneDeletedOne: t(lang, 'review.doneDeletedOne'),
  deleteStays: t(lang, 'review.deleteStays'),
  deleteDenied: t(lang, 'review.deleteDenied'),
  deleteFailed: t(lang, 'review.deleteFailed'),
  deleteClip: t(lang, 'review.deleteClip'),
  keepClip: t(lang, 'review.keepClip'),
  deleteClipConfirm: t(lang, 'review.deleteClipConfirm'),
};
const colors = [
  { value: '#ffd400', token: 'var(--c-yellow)' },
  { value: '#e4261c', token: 'var(--c-red)' },
  { value: '#ffffff', token: 'var(--c-white)' },
];
const speeds = [0.25, 0.5, 1];
const kinds = [
  { id: 'landscape', icon: '🏞', label: t(lang, 'review.kindLandscape') },
  { id: 'extras', icon: '🎉', label: t(lang, 'review.kindExtras') },
] as const;
const demoClips = [
  { time: '10:38', name: 'C0231.MP4', length: '0:24', tags: surfers.slice(1, 3) },
  { time: '10:42', name: 'C0232.MP4', length: '0:31', active: true, capture: true, tags: surfers.slice(0, 1) },
  { time: '10:47', name: 'C0233.MP4', length: '0:19', kinds: '🏞' },
  { time: '≈10:55', name: 'C0234.MOV', length: '0:40', broken: true },
  { time: '11:06', name: 'C0236.MP4', length: '0:22', remove: true },
];
---

<section
  class="review"
  data-review={!demo ? '' : undefined}
  data-demo={demo ? '' : undefined}
  data-folder={audio?.driveFolder}
  data-client-id={audio?.googleClientId}
  data-time-zone={timeZone}
  data-texts={JSON.stringify(texts)}
  data-list={demo ? 'open' : undefined}
  data-record="closed"
  data-tags={demo && !demoPending ? 'open' : 'closed'}
  data-outbox={demoPending ? 'open' : 'closed'}
  data-tool={demo ? 'arrow' : ''}
  data-has-clips={demo ? 'true' : 'false'}
  data-view={demo ? 'ready' : 'empty'}
  data-recording={demo ? 'true' : 'false'}
  data-signed-in={gated ? 'false' : undefined}
>
  {
    gated && (
      <div class="gate">
        <div class="card prose">
          <p>{t(lang, 'review.gate')}</p>
          <button type="button" class="btn primary" data-action="sign-in">
            {t(lang, 'audio.login')}
          </button>
          <p class="help">{t(lang, 'audio.loginHelp')}</p>
          <p class="notice error" data-gate-error hidden></p>
        </div>
      </div>
    )
  }
  <div class="bar">
    <button
      type="button"
      class="btn icon"
      data-action="toggle-list"
      aria-expanded={demo ? 'true' : 'false'}
      title={t(lang, 'review.toggleList')}
      aria-label={t(lang, 'review.toggleList')}
    >
      ☰
    </button>
    <label class="field" data-field>
      <span class="field-label">{t(lang, 'review.session')}</span>
      <select data-date aria-describedby="lock-why">
        {
          dates.map((d) => (
            <option value={d}>
              {WEEKDAYS[lang][weekdayOf(d)]} {dayMonth(d)}
            </option>
          ))
        }
      </select>
      <span class="lock" data-lock-icon aria-hidden="true" hidden>🔒</span>
      <span class="visually-hidden" id="lock-why" data-lock-why aria-hidden="true"></span>
    </label>
    <button type="button" class="btn bar-pick" data-action="pick-folder" title={t(lang, 'review.pickFolder')} aria-label={t(lang, 'review.pickFolder')}>
      <span aria-hidden="true">📁</span><span class="label">{t(lang, 'review.pickFolder')}</span>
    </button>
    <label class="btn bar-pick" data-pick-files title={t(lang, 'review.pickFiles')} hidden>
      <span aria-hidden="true">🎞</span><span class="label">{t(lang, 'review.pickFiles')}</span>
      <input type="file" multiple accept="video/*,.mp4,.mov,.m4v" class="visually-hidden" data-files aria-label={t(lang, 'review.pickFiles')} />
    </label>
    <button type="button" class="btn reopen" data-action="reopen" hidden></button>
    <span class="spacer"></span>
    <button type="button" class="btn tour-replay" data-tour-replay title={t(lang, 'tour.replay')} aria-label={t(lang, 'tour.replay')}>?</button>
    <button
      type="button"
      class="btn rec-toggle"
      data-action="toggle-record"
      aria-expanded="false"
      aria-controls="record-pop"
      title={t(lang, 'review.record')}
      aria-label={t(lang, 'review.record')}
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="9" y="3" width="6" height="11" rx="3" />
        <path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3.5M8.5 21.5h7" />
      </svg><span class="rec-dot" aria-hidden="true"></span><span class="rec-label">{t(lang, 'review.recording')}</span>
    </button>
    <button type="button" class="btn" data-action="discard" data-lock title={t(lang, 'review.discard')} aria-label={t(lang, 'review.discard')} hidden={!demo}>
      <span aria-hidden="true">🗑</span><span class="label wide-only" aria-hidden="true">{t(lang, 'review.discard')}</span>
    </button>
    {
      audio && (
        <button
          type="button"
          class="btn primary"
          data-action="toggle-outbox"
          data-outbox-toggle
          aria-expanded={demoPending ? 'true' : 'false'}
          aria-controls="outbox"
          title={t(lang, 'review.openPending')}
          aria-label={demo ? format(t(lang, 'review.finishCount'), { n: 3 }) : undefined}
          hidden={!demo}
        >
          <span aria-hidden="true">⬆</span>
          <span class="finish-long" data-finish-label>{demo ? format(t(lang, 'review.finishCount'), { n: 3 }) : ''}</span>
          <span class="finish-short" data-finish-short>{demo ? 3 : ''}</span>
        </button>
      )
    }

    <div class="record-pop" id="record-pop" data-record-pop role="group" aria-labelledby="record-title">
      <p class="record-title" id="record-title">{t(lang, 'review.recordTitle')}</p>
      <p class="help">{t(lang, 'review.recordHelp')}</p>
      {!demo && <AudioUploader lang={lang} dates={dates} timeZone={timeZone} spots={spots} surfers={surfers} audio={audio} />}
    </div>
  </div>

  <aside class="clips" aria-label={t(lang, 'review.clips')}>
    <ol data-clip-list>
      {
        demo &&
          demoClips.map((c) => (
            <li class:list={[{ active: c.active, 'has-capture': c.capture, broken: c.broken, 'to-delete': c.remove }]}>
              <button type="button" class="clip" aria-current={c.active ? 'true' : undefined}>
                <span class="thumb demo-thumb" />
                <span class="meta">
                  <strong>
                    {c.time} <span class="len">{c.length}</span>
                  </strong>
                  <small>{c.name}</small>
                </span>
                {c.tags && (
                  <span class="clip-tags" aria-hidden="true">
                    {c.tags.map((s) => (
                      <span class="dot" style={`--accent: var(--c-${s.color})`} />
                    ))}
                  </span>
                )}
                {c.kinds && <span class="clip-kinds" aria-hidden="true">{c.kinds}</span>}
              </button>
              <button
                type="button"
                class="clip-delete"
                data-action="delete-clip"
                data-clip-delete
                data-lock
                aria-pressed={c.remove ? 'true' : 'false'}
                title={format(t(lang, c.remove ? 'review.keepClip' : 'review.deleteClip'), { name: c.name })}
                aria-label={format(t(lang, c.remove ? 'review.keepClip' : 'review.deleteClip'), { name: c.name })}
              >
                <span aria-hidden="true">🗑</span>
              </button>
            </li>
          ))
      }
    </ol>
    <template data-clip-template>
      <li>
        <button type="button" class="clip" data-clip-button>
          <img class="thumb" data-clip-thumb alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
          <span class="meta">
            <strong><span data-clip-time></span> <span class="len" data-clip-length></span></strong>
            <small aria-hidden="true" data-clip-name></small>
          </span>
          <span class="clip-tags" data-clip-tags aria-hidden="true"></span>
          <span class="clip-kinds" data-clip-kinds aria-hidden="true"></span>
          <span class="visually-hidden" data-clip-full></span>
          <span class="visually-hidden" data-clip-who></span>
          <span class="visually-hidden" data-clip-note></span>
        </button>
        <button type="button" class="clip-delete" data-action="delete-clip" data-clip-delete data-lock aria-pressed="false">
          <span aria-hidden="true">🗑</span>
        </button>
      </li>
    </template>
    <button
      type="button"
      class="btn drawer-pick"
      data-action="pick"
      data-label-folder={t(lang, 'review.pickFolder')}
      data-label-files={t(lang, 'review.pickFiles')}
    >
      📁 <span data-pick-label>{t(lang, 'review.pickFolder')}</span>
    </button>
    <button type="button" class="btn drawer-replay" data-tour-replay>
      <span aria-hidden="true">?</span>
      {t(lang, 'tour.replay')}
    </button>
    <p class="keys help">{t(lang, 'review.keys')}</p>
  </aside>

  <div class="rail" role="group" aria-label={t(lang, 'review.tools')}>
    <div class="tools">
      <button type="button" class="tool" data-action="tool" data-tool="pen" title={t(lang, 'review.pen')} aria-label={t(lang, 'review.pen')} aria-pressed="false">
        <ToolIcon name="pen" />
      </button>
      <button
        type="button"
        class="tool has-menu"
        data-action="arrow"
        data-tool="arrow"
        title={t(lang, 'review.arrowStraight')}
        aria-label={t(lang, 'review.arrowStraight')}
        aria-pressed={demo ? 'true' : 'false'}
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="arrow-menu"
      >
        <ToolIcon name="arrow" />
      </button>
      <button type="button" class="tool" data-action="tool" data-tool="circle" title={t(lang, 'review.circle')} aria-label={t(lang, 'review.circle')} aria-pressed="false">
        <ToolIcon name="circle" />
      </button>
      <button type="button" class="tool" data-action="undo" title={t(lang, 'review.undo')} aria-label={t(lang, 'review.undo')}><ToolIcon name="undo" /></button>
      <button type="button" class="tool" data-action="clear" title={t(lang, 'review.clear')} aria-label={t(lang, 'review.clear')}><ToolIcon name="clear" /></button>
      <button type="button" class="tool" data-action="pin" title={t(lang, 'review.pin')} aria-label={t(lang, 'review.pin')} aria-pressed="false"><ToolIcon name="pin" /></button>
    </div>
    <div class="colors">
      <button
        type="button"
        class="swatch"
        data-action="color"
        data-color={colors[0].value}
        data-colors={JSON.stringify(colors)}
        style={`--swatch: ${colors[0].token}`}
        title={t(lang, 'review.color')}
        aria-label={t(lang, 'review.color')}
      >
      </button>
    </div>
    <div class="snap">
      <button
        type="button"
        class="tool snap-btn"
        data-action="capture"
        data-lock
        title={t(lang, 'review.saveCapture')}
        aria-label={t(lang, 'review.saveCapture')}
      >
        📸
      </button>
    </div>
  </div>

  <div class="arrow-menu" id="arrow-menu" data-arrow-menu role="menu" aria-label={t(lang, 'review.arrow')} hidden>
    <button type="button" class="menu-item" role="menuitemradio" aria-checked="true" data-action="arrow-kind" data-kind="arrow" data-label={t(lang, 'review.arrowStraight')}>
      <ToolIcon name="arrow" /><span>{t(lang, 'review.arrowStraightShort')}</span>
    </button>
    <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-action="arrow-kind" data-kind="freeArrow" data-label={t(lang, 'review.arrowFree')}>
      <ToolIcon name="freeArrow" /><span>{t(lang, 'review.arrowFreeShort')}</span>
    </button>
  </div>

  <div class="viewer" data-viewer>
    <div class="stage" data-stage style={demo ? '--ar: 1.7778' : undefined}>
      <div class="frame">
        <video data-video playsinline preload="auto" class:list={{ 'demo-frame': demo }}></video>
        <canvas data-sketch></canvas>
        {
          demo && (
            <svg class="demo-drawing" viewBox="0 0 160 90" aria-hidden="true">
              <path d="M40 30 L74 44 M68 39 L74 44 L66 46" stroke="#ffd400" stroke-width="1.6" fill="none" stroke-linecap="round" />
              <ellipse cx="88" cy="48" rx="10" ry="13" stroke="#e4261c" stroke-width="1.6" fill="none" />
            </svg>
          )
        }
      </div>
    </div>

    <div class="state" data-state="empty">
      <div class="card prose">
        <p>{t(lang, 'review.empty')}</p>
        <p class="warn-text" data-empty-note hidden></p>
        <button
          type="button"
          class="btn primary"
          data-action="pick"
          data-label-folder={t(lang, 'review.pickFolder')}
          data-label-files={t(lang, 'review.pickFiles')}
        >
          📁 <span data-pick-label>{t(lang, 'review.pickFolder')}</span>
        </button>
      </div>
    </div>
    <div class="state loading" data-state="loading" role="status">
      <span class="spinner" aria-hidden="true"></span>
      <span>{t(lang, 'review.loading')}</span>
    </div>
    <div class="state" data-state="error">
      <div class="card prose">
        <p>{t(lang, 'review.unplayable')}</p>
        <button type="button" class="btn primary" data-action="next-clip" data-next-clip>{t(lang, 'review.nextClip')}</button>
      </div>
    </div>

    <p class="visually-hidden" role="status" data-announce></p>
    <div class="toasts" role="status" aria-live="polite">
      <div class="notice warn" data-restored hidden>
        <span data-restored-text></span>
        <button type="button" class="dismiss" data-action="dismiss" aria-label={t(lang, 'review.dismiss')} title={t(lang, 'review.dismiss')}>✕</button>
      </div>
      <div class="notice" data-message-box hidden={!demo}>
        <span data-message>{demo ? format(t(lang, 'review.captureTagged'), { n: 3, names: surfers[0]?.name ?? '' }) : ''}</span>
        <button type="button" class="btn small" data-action="retry" hidden>{t(lang, 'review.retry')}</button>
        <button type="button" class="dismiss" data-action="dismiss" aria-label={t(lang, 'review.dismiss')} title={t(lang, 'review.dismiss')}>✕</button>
      </div>
    </div>
  </div>

  <div class="transport">
    <div class="t-step">
      <button type="button" class="btn small" data-action="prev-frame" title={t(lang, 'review.prevFrame')} aria-label={t(lang, 'review.prevFrame')}>|◀</button>
      <button type="button" class="btn small play" data-action="play" title={t(lang, 'review.play')} aria-label={t(lang, 'review.play')}>
        <span class="when-paused">▶</span><span class="when-playing">❚❚</span>
      </button>
      <button type="button" class="btn small" data-action="next-frame" title={t(lang, 'review.nextFrame')} aria-label={t(lang, 'review.nextFrame')}>▶|</button>
    </div>
    <div class="t-seek">
      <input type="range" class="seek" min="0" max={demo ? '31' : '0'} step="any" value={demo ? '13.4' : '0'} style={demo ? '--played: 43%' : undefined} data-seek aria-label={t(lang, 'review.timeline')} />
      <span class="readout"><span data-pos>{demo ? '0:13.40' : ''}</span><span class="wave"> · <span data-wave>{demo ? '10:42:18' : ''}</span></span></span>
    </div>
    <div class="t-opts">
      <span class="rates" role="group" aria-label={t(lang, 'review.speed')}>
        {
          speeds.map((r) => (
            <button type="button" class="btn small" data-action="rate" data-rate={r} aria-pressed={(demo ? r === 0.5 : r === 1) ? 'true' : 'false'}>
              {r}×
            </button>
          ))
        }
      </span>
      <button type="button" class="btn small rate-cycle" data-action="cycle-rate" data-rates={[1, 0.5, 0.25].join(' ')}>
        <span class="visually-hidden">{t(lang, 'review.speed')}</span><span data-rate-label>{demo ? '0.5×' : '1×'}</span>
      </button>
      <button
        type="button"
        class="btn small"
        data-action="fullscreen"
        title={t(lang, 'review.fullscreen')}
        aria-label={t(lang, 'review.fullscreen')}
        aria-pressed="false"
      >
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
        </svg>
      </button>
    </div>
  </div>

  <div class="tagger" data-tagger>
    <button
      type="button"
      class="tag-pill"
      data-action="toggle-tags"
      aria-expanded={demo && !demoPending ? 'true' : 'false'}
      aria-controls="tag-pop"
      title={t(lang, 'review.tags')}
    >
      <span class="visually-hidden">{t(lang, 'review.tags')}:</span>
      <span aria-hidden="true">👥</span>
      <span class="pill-dots" data-pill-dots aria-hidden="true">
        {demo && surfers[0] && <span class="dot" style={`--accent: var(--c-${surfers[0].color})`} />}
      </span>
      <span class="pill-label" data-pill-label>{demo ? (surfers[0]?.name ?? '') : t(lang, 'review.whoSurfs')}</span>
      <span class="chev" aria-hidden="true">▾</span>
    </button>
    <div class="tag-pop" id="tag-pop" data-tag-pop role="group" aria-label={t(lang, 'review.tags')}>
      <p class="pop-title" id="who-title">{t(lang, 'review.whoSurfs')}</p>
      <div class="surfers" role="group" aria-labelledby="who-title">
        {
          surfers.map((s, i) => (
            <label class="pick" style={`--accent: var(--c-${s.color})`}>
              <input type="checkbox" class="visually-hidden" value={s.id} data-surfer data-lock checked={demo && i === 0} />
              <Avatar id={s.id} name="" size="sm" />
              <span class="pick-name">{s.name}</span>
            </label>
          ))
        }
      </div>
      <p class="pop-title kinds-title" id="kind-title">{t(lang, 'review.clipIs')}</p>
      <div class="kinds" role="group" aria-labelledby="kind-title">
        {
          kinds.map((k) => (
            <label class:list={['pick', 'kind', `kind-${k.id}`]}>
              <input type="checkbox" class="visually-hidden" value={k.id} data-kind data-lock />
              <span aria-hidden="true">{k.icon}</span>
              <span class="pick-name">{k.label}</span>
            </label>
          ))
        }
      </div>
    </div>
  </div>

  <section class="outbox" id="outbox" data-outbox-panel aria-labelledby="outbox-title">
    <div class="outbox-head">
      <h2 id="outbox-title">{t(lang, 'review.pending')}</h2>
      <button type="button" class="dismiss" data-action="toggle-outbox" aria-label={t(lang, 'review.dismiss')} title={t(lang, 'review.dismiss')}>
        ✕
      </button>
    </div>
    <div class="outbox-body">
      <div class="filters" role="group" aria-label={t(lang, 'review.filter')}>
        <button type="button" class="filter" data-action="filter" data-filter="all" aria-pressed="true">
          <span class="filter-text">{t(lang, 'review.filterAll')}</span>
        </button>
        {
          surfers.map((s) => (
            <button
              type="button"
              class="filter"
              data-action="filter"
              data-filter={s.id}
              aria-pressed="false"
              title={s.name}
              aria-label={s.name}
              style={`--accent: var(--c-${s.color})`}
            >
              <Avatar id={s.id} name="" size="sm" />
            </button>
          ))
        }
        {
          kinds.map((k) => (
            <button type="button" class="filter" data-action="filter" data-filter={k.id} aria-pressed="false" title={k.label} aria-label={k.label}>
              <span class="filter-text" aria-hidden="true">{k.icon}</span>
            </button>
          ))
        }
      </div>
      <p class="help none" data-none hidden>{t(lang, 'review.noneFiltered')}</p>
