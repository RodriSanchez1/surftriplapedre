---
/**
 * The coach's video review: clips from disk, a player, drawing on the paused frame and captures.
 * An app screen: the page does not scroll. The parent gives it a box (the app shell in BaseLayout, or a
 * fixed-height frame on /design/) and the video takes what the controls leave. The client logic is in
 * src/lib/review/page.ts. With `demo` a filled-in state is shown and the script leaves it alone.
 */
import { dayMonth, weekdayOf } from '../lib/calendar';
import { WEEKDAYS, format, t, type Lang } from '../lib/i18n';
import type { Texts } from '../lib/review/page';
import AudioUploader from './AudioUploader.astro';
import Avatar from './Avatar.astro';

interface Props {
  lang: Lang;
  dates: string[];
  timeZone: string;
  spots?: string[];
  surfers: { id: string; name: string; color: string }[];
  audio?: { driveFolder: string; googleClientId: string; contact: string };
  demo?: boolean;
}

const { lang, dates, timeZone, spots = [], surfers, audio, demo = false } = Astro.props;
const texts: Texts = {
  reopen: t(lang, 'review.reopen'),
  noVideos: t(lang, 'review.noVideos'),
  unplayable: t(lang, 'review.unplayable'),
  approx: t(lang, 'review.approx'),
  captureTagged: t(lang, 'review.captureTagged'),
  captureUntagged: t(lang, 'review.captureUntagged'),
  openCapture: t(lang, 'review.openCapture'),
  deleteCapture: t(lang, 'review.deleteCapture'),
  deleteCaptureConfirm: t(lang, 'review.deleteCaptureConfirm'),
  finishCount: t(lang, 'review.finishCount'),
  sessionLocked: t(lang, 'review.sessionLocked'),
  restored: t(lang, 'review.restored'),
  discardConfirm: t(lang, 'review.discardConfirm'),
  nothing: t(lang, 'review.nothing'),
  uploading: t(lang, 'review.uploading'),
  done: t(lang, 'review.done'),
  errorUpload: t(lang, 'review.errorUpload'),
  errorPermission: format(t(lang, 'audio.errorPermission'), { contact: audio?.contact ?? '' }),
  errorLogin: t(lang, 'audio.errorLogin'),
};
const colors = [
  { value: '#ffd400', token: 'var(--c-yellow)' },
  { value: '#e4261c', token: 'var(--c-red)' },
  { value: '#ffffff', token: 'var(--c-white)' },
];
const speeds = [0.25, 0.5, 1];
const tools = [
  { id: 'pen', icon: '✎', label: t(lang, 'review.pen') },
  { id: 'arrow', icon: '➚', label: t(lang, 'review.arrow') },
  { id: 'circle', icon: '◯', label: t(lang, 'review.circle') },
] as const;
const demoClips = [
  { time: '10:38', name: 'C0231.MP4', length: '0:24' },
  { time: '10:42', name: 'C0232.MP4', length: '0:31', active: true, capture: true },
  { time: '10:47', name: 'C0233.MP4', length: '0:19' },
  { time: '≈10:55', name: 'C0234.MOV', length: '0:40', broken: true },
];
---

<section
  class="review"
  data-review={!demo ? '' : undefined}
  data-demo={demo ? '' : undefined}
  data-folder={audio?.driveFolder}
  data-client-id={audio?.googleClientId}
  data-time-zone={timeZone}
  data-texts={JSON.stringify(texts)}
  data-list={demo ? 'open' : undefined}
  data-record="closed"
  data-tool={demo ? 'arrow' : ''}
  data-has-clips={demo ? 'true' : 'false'}
  data-view={demo ? 'ready' : 'empty'}
  data-recording={demo ? 'true' : 'false'}
>
  <div class="bar">
    <button type="button" class="btn icon" data-action="toggle-list" title={t(lang, 'review.toggleList')} aria-label={t(lang, 'review.toggleList')}>
      ☰
    </button>
    <label class="field">
      <span class="field-label">{t(lang, 'review.session')}</span>
      <select data-date>
        {
          dates.map((d) => (
            <option value={d}>
              {WEEKDAYS[lang][weekdayOf(d)]} {dayMonth(d)}
            </option>
          ))
        }
      </select>
    </label>
    <button type="button" class="btn bar-pick" data-action="pick-folder" title={t(lang, 'review.pickFolder')}>
      <span aria-hidden="true">📁</span><span class="label">{t(lang, 'review.pickFolder')}</span>
    </button>
    <label class="btn bar-pick" data-pick-files title={t(lang, 'review.pickFiles')} hidden>
      <span aria-hidden="true">🎞</span><span class="label">{t(lang, 'review.pickFiles')}</span>
      <input type="file" multiple accept="video/*,.mp4,.mov,.m4v" class="visually-hidden" data-files />
    </label>
    <button type="button" class="btn reopen" data-action="reopen" hidden></button>
    <span class="spacer"></span>
    <button
      type="button"
      class="btn rec-toggle"
      data-action="toggle-record"
      aria-expanded="false"
      title={t(lang, 'review.record')}
      aria-label={t(lang, 'review.record')}
    >
      <span aria-hidden="true">🎙</span><span class="rec-dot" aria-hidden="true"></span><span class="rec-label">{t(lang, 'review.recording')}</span>
    </button>
    <button type="button" class="btn" data-action="discard" data-lock title={t(lang, 'review.discard')} aria-label={t(lang, 'review.discard')} hidden={!demo}>
      <span aria-hidden="true">🗑</span><span class="label wide-only" aria-hidden="true">{t(lang, 'review.discard')}</span>
    </button>
    {
      audio && (
        <button type="button" class="btn primary" data-action="finish" data-lock title={t(lang, 'review.finish')} hidden={!demo}>
          <span aria-hidden="true">⬆</span>
          <span class="finish-long" data-finish-label>{demo ? format(t(lang, 'review.finishCount'), { n: 3 }) : ''}</span>
          <span class="finish-short" data-finish-short>{demo ? 3 : ''}</span>
        </button>
      )
    }

    <div class="record-pop" data-record-pop>
      <p class="help">{t(lang, 'review.recordHelp')}</p>
      {!demo && <AudioUploader lang={lang} dates={dates} timeZone={timeZone} spots={spots} surfers={surfers} audio={audio} />}
    </div>
  </div>

  <aside class="clips" aria-label={t(lang, 'review.clips')}>
    <ol data-clip-list>
      {
        demo &&
          demoClips.map((c) => (
            <li class:list={['clip', { active: c.active, 'has-capture': c.capture, broken: c.broken }]}>
              <span class="thumb demo-thumb" />
              <span class="meta">
                <strong>{c.time}</strong>
                <small>
                  {c.name} · {c.length}
                </small>
              </span>
            </li>
          ))
      }
    </ol>
    <template data-clip-template>
      <li class="clip" tabindex="0">
        <img class="thumb" data-clip-thumb alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
        <span class="meta">
          <strong data-clip-time></strong>
          <small><span data-clip-name></span> · <span data-clip-length></span></small>
        </span>
      </li>
    </template>
    <button
      type="button"
      class="btn drawer-pick"
      data-action="pick"
      data-label-folder={t(lang, 'review.pickFolder')}
      data-label-files={t(lang, 'review.pickFiles')}
    >
      📁 <span data-pick-label>{t(lang, 'review.pickFolder')}</span>
    </button>
    <p class="keys help">{t(lang, 'review.keys')}</p>
  </aside>

  <div class="rail" role="toolbar" aria-label={t(lang, 'review.tools')}>
    <div class="tools">
      {
        tools.map((tool) => (
          <button
            type="button"
            class="tool"
            data-action="tool"
            data-tool={tool.id}
            title={tool.label}
            aria-label={tool.label}
            aria-pressed={demo && tool.id === 'arrow' ? 'true' : 'false'}
          >
            {tool.icon}
          </button>
        ))
      }
      <button type="button" class="tool" data-action="undo" title={t(lang, 'review.undo')} aria-label={t(lang, 'review.undo')}>↶</button>
      <button type="button" class="tool" data-action="clear" title={t(lang, 'review.clear')} aria-label={t(lang, 'review.clear')}>⌫</button>
      <button type="button" class="tool" data-action="pin" title={t(lang, 'review.pin')} aria-label={t(lang, 'review.pin')} aria-pressed="false">📌</button>
    </div>
    <div class="colors">
      <button
        type="button"
        class="swatch"
        data-action="color"
        data-color={colors[0].value}
        data-colors={JSON.stringify(colors)}
        style={`--swatch: ${colors[0].token}`}
        title={t(lang, 'review.color')}
        aria-label={t(lang, 'review.color')}
      >
      </button>
    </div>
  </div>

  <div class="viewer" data-viewer>
    <div class="stage" data-stage style={demo ? '--ar: 1.7778' : undefined}>
      <div class="frame">
        <video data-video playsinline preload="auto" class:list={{ 'demo-frame': demo }}></video>
        <canvas data-sketch></canvas>
        {
          demo && (
            <svg class="demo-drawing" viewBox="0 0 160 90" aria-hidden="true">
              <path d="M40 30 L74 44 M68 39 L74 44 L66 46" stroke="#ffd400" stroke-width="1.6" fill="none" stroke-linecap="round" />
              <ellipse cx="88" cy="48" rx="10" ry="13" stroke="#e4261c" stroke-width="1.6" fill="none" />
            </svg>
          )
        }
      </div>
    </div>

    <div class="state" data-state="empty">
      <div class="card prose">
        <p>{t(lang, 'review.empty')}</p>
        <p class="warn-text" data-empty-note hidden></p>
        <button
          type="button"
          class="btn primary"
          data-action="pick"
          data-label-folder={t(lang, 'review.pickFolder')}
          data-label-files={t(lang, 'review.pickFiles')}
        >
          📁 <span data-pick-label>{t(lang, 'review.pickFolder')}</span>
        </button>
      </div>
    </div>
    <div class="state loading" data-state="loading" role="status">
      <span class="spinner" aria-hidden="true"></span>
      <span>{t(lang, 'review.loading')}</span>
    </div>
    <div class="state" data-state="error">
      <div class="card prose">
        <p>{t(lang, 'review.unplayable')}</p>
        <button type="button" class="btn primary" data-action="next-clip" data-next-clip>{t(lang, 'review.nextClip')}</button>
      </div>
    </div>

    <div class="toasts" role="status" aria-live="polite">
      <div class="notice warn" data-restored hidden>
        <span data-restored-text></span>
        <button type="button" class="dismiss" data-action="dismiss" aria-label={t(lang, 'review.dismiss')} title={t(lang, 'review.dismiss')}>✕</button>
      </div>
      <div class="notice" data-message-box hidden={!demo}>
        <span data-message>{demo ? format(t(lang, 'review.captureTagged'), { n: 3, names: surfers[0]?.name ?? '' }) : ''}</span>
        <button type="button" class="btn small" data-action="retry" hidden>{t(lang, 'review.retry')}</button>
        <button type="button" class="dismiss" data-action="dismiss" aria-label={t(lang, 'review.dismiss')} title={t(lang, 'review.dismiss')}>✕</button>
      </div>
    </div>
  </div>

  <div class="transport">
    <div class="t-step">
      <button type="button" class="btn small" data-action="prev-frame" title={t(lang, 'review.prevFrame')} aria-label={t(lang, 'review.prevFrame')}>|◀</button>
      <button type="button" class="btn small play" data-action="play" title={t(lang, 'review.play')} aria-label={t(lang, 'review.play')}>
        <span class="when-paused">▶</span><span class="when-playing">❚❚</span>
      </button>
      <button type="button" class="btn small" data-action="next-frame" title={t(lang, 'review.nextFrame')} aria-label={t(lang, 'review.nextFrame')}>▶|</button>
    </div>
    <div class="t-seek">
      <input type="range" class="seek" min="0" max={demo ? '31' : '0'} step="any" value={demo ? '13.4' : '0'} style={demo ? '--played: 43%' : undefined} data-seek aria-label={t(lang, 'review.timeline')} />
      <span class="readout"><span data-pos>{demo ? '0:13.40' : ''}</span><span class="wave"> · <span data-wave>{demo ? '10:42:18' : ''}</span></span></span>
    </div>
    <div class="t-opts">
      <span class="rates" role="group" aria-label={t(lang, 'review.speed')}>
        {
          speeds.map((r) => (
            <button type="button" class="btn small" data-action="rate" data-rate={r} aria-pressed={(demo ? r === 0.5 : r === 1) ? 'true' : 'false'}>
              {r}×
            </button>
          ))
        }
      </span>
      <button type="button" class="btn small rate-cycle" data-action="cycle-rate" data-rates={[1, 0.5, 0.25].join(' ')}>
        <span class="visually-hidden">{t(lang, 'review.speed')}</span><span data-rate-label>{demo ? '0.5×' : '1×'}</span>
      </button>
      <button type="button" class="btn small" data-action="fullscreen" title={t(lang, 'review.fullscreen')} aria-label={t(lang, 'review.fullscreen')}>⛶</button>
    </div>
  </div>

  <div class="dock">
    <div class="capture">
      <span class="whose" id="whose">{t(lang, 'review.whose')}</span>
      <span class="surfers" role="group" aria-labelledby="whose">
        {
          surfers.map((s, i) => (
            <label class="pick" style={`--accent: var(--c-${s.color})`}>
              <input type="checkbox" class="visually-hidden" value={s.id} data-surfer checked={demo && i === 0} />
              <Avatar id={s.id} name="" size="sm" />
              <span class="pick-name">{s.name}</span>
            </label>
          ))
        }
      </span>
      <button type="button" class="btn primary" data-action="capture" data-lock title={t(lang, 'review.saveCapture')}>
        <span aria-hidden="true">📸</span> <span class="capture-label">{t(lang, 'review.saveCapture')}</span></button>
    </div>
    <div class="shots-box" data-shots-box hidden={!demo}>
      <span class="shots-head" data-shots-head title={t(lang, 'review.captures')}>
        <span class="visually-hidden">{t(lang, 'review.captures')}</span>
        <span aria-hidden="true">📷</span>
        <b class="count" data-shots-count>{demo ? 3 : 0}</b>
      </span>
      <div class="shots" data-shots>
        {
          demo &&
            [1, 2, 3].map((n) => (
              <figure class="shot">
                <span class="shot-open">
                  <span class="demo-thumb" />
                </span>
                {n === 1 && surfers[0] && (
                  <span class="shot-tags" aria-hidden="true">
                    <Avatar id={surfers[0].id} name="" size="sm" />
                  </span>
                )}
                <button type="button" class="shot-remove">✕</button>
              </figure>
            ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { init } from '../lib/review/page';
  document.querySelectorAll<HTMLElement>('[data-review]').forEach(init);
</script>

<style>
  /* Phone portrait is the base; the laptop and the phone on its side are the two media blocks at the end. */
  .review {
    --list-w: 15rem;
    --hit: 44px;
    position: relative;
    height: 100%;
    min-height: 0;
    max-width: 1800px;
    margin-inline: auto;
    padding: var(--s-2);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto auto auto;
    grid-template-areas: 'bar' 'viewer' 'rail' 'transport' 'dock';
    gap: var(--s-2);
    overflow: hidden;
    /* Dragging to draw must not select text. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .review input,
  .review select,
  .record-pop {
    user-select: text;
    -webkit-user-select: text;
  }

  /* Top bar: one compact row. */
  .bar {
    grid-area: bar;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .bar > .btn {
    flex: none;
    min-height: var(--hit);
    min-width: var(--hit);
    padding-block: var(--s-1);
    padding-inline: var(--s-3);
  }
  .bar > .reopen {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spacer {
    flex: 1;
  }
  /* Narrow screens: the date box shrinks instead of covering the buttons next to it. */
  .field {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font: 13px var(--font-head);
    flex: 0 1 8rem;
    min-width: 0;
  }
  select {
    font: 16px var(--font-body);
    min-height: var(--hit);
    width: 100%;
    min-width: 0;
    max-width: 9rem;
    padding: var(--s-1) var(--s-2);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--c-white);
  }
  select:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  label.btn:focus-within {
    outline: 3px solid var(--c-sky);
    outline-offset: 2px;
  }
  .btn .label,
  .field-label,
  .rec-label {
    display: none;
  }
  [data-has-clips='false'] [data-action='toggle-list'] {
    display: none;
  }
  /* With clips loaded, the drawer has the folder button: the bar needs the room. */
  [data-has-clips='true'] .bar > .bar-pick {
    display: none;
  }
  .drawer-pick {
    flex: none;
    margin-top: var(--s-2);
    min-height: var(--hit);
  }
  .finish-short {
    font: 14px var(--font-strong);
  }
  .finish-long {
    display: none;
  }
  [data-uploading='true'] [data-action='finish']:disabled {
    opacity: 1;
    cursor: progress;
  }

  /* Audio recording: a button in the bar with a popover; the uploader inside stays mounted. */
  .rec-dot {
    display: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-red);
    animation: blink 1.2s steps(2) infinite;
  }
  [data-recording='true'] .rec-dot {
    display: inline-block;
  }
  [data-recording='true'] .rec-label {
    color: var(--c-red);
  }
  .rec-toggle[aria-expanded='true'] {
    background: var(--c-yellow);
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .help {
    font-size: 14px;
    color: var(--c-muted);
  }
  .record-pop {
    display: none;
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--s-2));
    right: 0;
    width: min(28rem, 100%);
    max-height: calc(100dvh - 8rem);
    overflow: auto;
    padding: var(--s-3);
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  [data-record='open'] .record-pop {
    display: block;
  }
  .record-pop .help {
    margin-top: 0;
  }
  .record-pop :global(.uploader) {
    border: 0;
    box-shadow: none;
    padding: 0;
    background: none;
  }

  /* Clips: a drawer over the picture (opened with the list button). */
  .clips {
    grid-area: viewer;
    z-index: 20;
    display: none;
    flex-direction: column;
    min-height: 0;
    width: min(20rem, 88%);
    padding: var(--s-2);
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  [data-list='open'][data-has-clips='true'] .clips {
    display: flex;
  }
  .clips ol {
    list-style: none;
    margin: 0;
    padding: 2px 6px 6px 2px;
    display: grid;
    gap: var(--s-2);
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    align-content: start;
  }
  .keys {
    margin: var(--s-2) 0 0;
  }
  .clip {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--hit);
    padding: var(--s-1) var(--s-2);
    background: var(--c-white);
    border: var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .clip:hover,
  .clip:focus-visible {
    box-shadow: var(--shadow);
    outline: none;
  }
  .clip.active {
    background: var(--c-yellow);
  }
  .clip.broken {
    opacity: 0.55;
    text-decoration: line-through;
  }
  .clip.has-capture strong::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: var(--s-1);
    border-radius: 50%;
    background: var(--c-red);
    vertical-align: middle;
  }
  .thumb {
    width: 64px;
    height: 36px;
    flex: none;
    object-fit: cover;
    border-radius: 4px;
    background: var(--c-ink);
  }
  .meta {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .meta small {
    color: var(--c-muted);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Drawing tools and colours: a rail outside the picture. */
  .rail {
    grid-area: rail;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1);
    padding: var(--s-1);
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    min-height: 0;
  }
  .tools,
  .colors {
    display: contents;
  }
  .tool,
  .swatch {
    flex: 1 1 0;
    min-width: 0;
    height: var(--hit);
    display: grid;
    place-items: center;
    cursor: pointer;
    background: var(--c-white);
    border: 2px solid var(--c-ink);
    border-radius: 6px;
  }
  .tool {
    padding: 0;
    font-size: 20px;
  }
  .tool[aria-pressed='true'] {
    background: var(--c-yellow);
  }
  /* One button for the colour: it shows the colour in use and each tap goes to the next. */
  .swatch {
    padding: 0;
  }
  .swatch::before {
    content: '';
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--c-ink);
    background: var(--swatch);
  }

  /* The picture. It fills its cell; the frame inside has the clip's own proportions. */
  .viewer {
    grid-area: viewer;
    position: relative;
    min-width: 0;
    min-height: 0;
    background: var(--c-ink);
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .viewer[data-dragging] {
    outline: 4px dashed var(--c-yellow);
    outline-offset: -10px;
  }
  .stage {
    position: absolute;
    inset: 0;
    container-type: size;
    display: grid;
