---
/** Red band with a lightning-bolt cut. 'hero' for the home page, 'page' for the rest. */
interface Props {
  title: string;
  kicker?: string;
  subtitle?: string;
  /** Short facts under the title, each with its icon. */
  facts?: { icon: 'place' | 'dates'; text: string }[];
  size?: 'hero' | 'page';
}

const { title, kicker, subtitle, facts, size = 'page' } = Astro.props;
---

<div class:list={['band', size]}>
  <div class="wrap inner">
    {Astro.slots.has('media') && <div class="media"><slot name="media" /></div>}
    <div>
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {
        facts && (
          <ul class="facts">
            {facts.map((f) => (
              <li>
                {f.icon === 'place' ? (
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" fill="var(--c-yellow)" />
                    <circle cx="12" cy="9" r="2.5" fill="var(--c-red)" />
                  </svg>
                ) : (
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="3" fill="var(--c-yellow)" />
                    <rect x="3" y="5" width="18" height="5" rx="2" fill="var(--c-ink)" />
                    <rect x="7" y="2" width="3" height="5" rx="1.5" fill="var(--c-ink)" />
                    <rect x="14" y="2" width="3" height="5" rx="1.5" fill="var(--c-ink)" />
                    <rect x="7" y="13" width="4" height="4" fill="var(--c-red)" />
                  </svg>
                )}
                {f.text}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</div>

<style>
  .band {
    background: var(--c-red);
    color: var(--c-white);
    clip-path: polygon(0 0, 100% 0, 100% 78%, 62% 100%, 66% 84%, 0 96%);
    padding: var(--s-5) 0 var(--s-6);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  /* The media keeps its size when a long title wraps. */
  .media {
    flex: none;
  }
  .kicker {
    font: 13px var(--font-head);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--s-2);
    color: var(--c-yellow);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    margin: 0;
  }
  .hero {
    padding: clamp(28px, 5vw, 48px) 0 clamp(64px, 10vw, 104px);
    margin-bottom: var(--s-2);
  }
  /* Narrow measure so the trip name breaks into two big lines. */
  .hero h1 {
    font-size: clamp(36px, 9.5vw, 88px);
    line-height: 0.95;
    max-width: 11ch;
  }
  .page h1 {
    font-size: clamp(28px, 6vw, 48px);
  }
  .subtitle {
    font: 15px/1.4 var(--font-strong);
    margin: var(--s-2) 0 0;
    color: #ffe3c2;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) 40px;
    margin: clamp(16px, 3vw, 28px) 0 0;
    padding: 0;
    list-style: none;
    font: clamp(16px, 2.4vw, 20px) / 1.3 var(--font-strong);
    color: #ffe3c2;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .icon {
    flex: none;
    width: 1em;
    height: 1em;
  }
</style>
