---
import '@fontsource/bungee';
import '@fontsource/bungee-shade';
import '@fontsource/archivo-black';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from './SiteHeader.astro';
import tokens from '../styles/tokens.css?raw';
import { LANGS, t, type Lang } from '../lib/i18n';
import { parseColors } from '../lib/og/colors';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og/meta';

interface Props {
  title: string;
  lang: Lang;
  team: string;
  /** Trip name, shown as the site in link previews. */
  siteName?: string;
  /** Text under the title in search results and link previews. */
  description?: string;
  /** Link preview image, /og/<lang>/<image>.png (see src/lib/og/meta.ts). The home one by default. */
  image?: string;
  /** false on pages that only exist in one language, like /design/. */
  langSwitch?: boolean;
  /** App shell: fills the screen (100dvh), no footer and no page scroll. For tools like /review/. */
  app?: boolean;
}

const { title, lang, team, siteName, description, image = 'index', langSwitch = true, app = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(`${base.replace(/\/$/, '')}/${ogImagePath(lang, image)}`, site).href;
const themeColor = parseColors(tokens).red;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={app ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={themeColor} />

    <!-- Link previews (WhatsApp, Discord, Telegram, X...) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    <meta property="og:locale" content={t(lang, 'site.locale')} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l, 'site.locale')} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body data-app={app ? '' : undefined}>
    <SiteHeader lang={lang} team={team} langSwitch={langSwitch} />
    <main>
      <slot />
    </main>
    {!app && <footer class="wrap">⚡ {team}</footer>}
  </body>
</html>

<style>
  footer {
    font: 13px var(--font-head);
    text-align: center;
    padding: var(--s-6) var(--s-4);
  }
</style>

<style is:global>
  /* App shell: the header and one cell that takes the rest of the screen. Nothing scrolls the page. */
  body[data-app] {
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  body[data-app] > main {
    /* Always the second row, also when the header is hidden. */
    grid-row: 2;
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }
  /* The app starts at the screen edge, so the header does too (not centred at the site's reading width). */
  body[data-app] > header .wrap {
    max-width: none;
    margin: 0;
  }
  /* "Immersive" hides the site header; a phone held sideways has no height to spare for it either. */
  body[data-app][data-immersive] > header {
    display: none;
  }
  @media (orientation: landscape) and (max-height: 500px) {
    body[data-app] > header {
      display: none;
    }
  }
</style>
