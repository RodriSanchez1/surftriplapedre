---
import '@fontsource/bungee';
import '@fontsource/bungee-shade';
import '@fontsource/archivo-black';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from './SiteHeader.astro';
import type { Lang } from '../lib/i18n';

interface Props {
  title: string;
  lang: Lang;
  equipo: string;
  description?: string;
  /** false en páginas que solo existen en un idioma, como /design/. */
  langSwitch?: boolean;
}

const { title, lang, equipo, description, langSwitch = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body>
    <SiteHeader lang={lang} equipo={equipo} langSwitch={langSwitch} />
    <main>
      <slot />
    </main>
    <footer class="wrap">⚡ {equipo}</footer>
  </body>
</html>

<style>
  footer {
    font: 13px var(--font-head);
    text-align: center;
    padding: var(--s-6) var(--s-4);
  }
</style>
