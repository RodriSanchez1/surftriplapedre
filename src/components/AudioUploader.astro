---
/**
 * Record or upload the audio of a session to the trip's Drive folder.
 * The client logic is in src/lib/audio/page.ts.
 * With `demo` a fixed state is shown and the script leaves it alone (for /design/).
 */
import { dayMonth, weekdayOf } from '../lib/calendar';
import { WEEKDAYS, format, t, type Lang } from '../lib/i18n';
import type { State, Texts } from '../lib/audio/page';
import FootageCard from './FootageCard.astro';

interface Props {
  lang: Lang;
  dates: string[];
  timeZone: string;
  spots?: string[];
  surfers?: { id: string; name: string; color: string }[];
  audio?: { driveFolder: string; googleClientId: string; contact: string };
  demo?: State;
}

const { lang, dates, timeZone, spots = [], surfers = [], audio, demo } = Astro.props;
const texts: Texts = {
  cut: t(lang, 'audio.cut'),
  pending: t(lang, 'audio.pending'),
  discardConfirm: t(lang, 'audio.discardConfirm'),
  errorUpload: t(lang, 'audio.errorUpload'),
  errorPermission: format(t(lang, 'audio.errorPermission'), { contact: audio?.contact ?? '' }),
  errorLogin: t(lang, 'audio.errorLogin'),
  errorMic: t(lang, 'audio.errorMic'),
  upload: t(lang, 'audio.upload'),
  discard: t(lang, 'audio.discard'),
};
---

{
  !audio ? (
    <p class="notice warn">{t(lang, 'audio.notConfigured')}</p>
  ) : (
    <section
      class="uploader prose"
      data-audio
      data-state={demo ?? 'login'}
      data-demo={demo}
      data-folder={audio.driveFolder}
      data-client-id={audio.googleClientId}
      data-time-zone={timeZone}
      data-texts={JSON.stringify(texts)}
    >
      <div data-step="login">
        <button type="button" class="btn primary" data-action="login">
          {t(lang, 'audio.login')}
        </button>
        <p class="help">{t(lang, 'audio.loginHelp')}</p>
      </div>

      <div data-step="ready">
        <p>
          {t(lang, 'audio.connectedAs')} <strong data-email>{demo ? 'coach@gmail.com' : ''}</strong>
        </p>
        <label class="field">
          {t(lang, 'audio.session')}
          <select data-date>
            {dates.map((d) => (
              <option value={d}>
                {WEEKDAYS[lang][weekdayOf(d)]} {dayMonth(d)}
              </option>
            ))}
          </select>
        </label>
        <div data-footage-slot>
          <fieldset class="footage" data-footage>
            <legend>{t(lang, 'footage.title')}</legend>
            <p class="help">{t(lang, 'footage.help')}</p>
            <div data-footage-cards>
              <FootageCard lang={lang} dates={dates} spots={spots} surfers={surfers} date={dates[0]} time="morning" />
            </div>
            <button type="button" class="btn" data-action="add-footage">
              + {t(lang, 'footage.add')}
            </button>
          </fieldset>
        </div>
        <div class="actions">
          <button type="button" class="btn record" data-action="record">
            ● {t(lang, 'audio.record')}
          </button>
          <label class="btn">
            {t(lang, 'audio.pickFile')}
            <input type="file" accept="audio/*" class="visually-hidden" data-file />
          </label>
        </div>
        <p class="notice warn" data-no-recorder hidden>
          {t(lang, 'audio.noRecorder')}
        </p>
        <div class="picked" data-picked hidden>
          <strong data-picked-name />
          <button type="button" class="btn primary" data-action="upload-file">
            {t(lang, 'audio.uploadFile')}
          </button>
        </div>
      </div>

      <div data-step="recording">
        <p class="clock" data-clock>
          {demo ? '12:34' : '0:00'}
        </p>
        <div class="level">
          <span data-level style={demo ? 'transform: scaleX(0.6)' : undefined} />
        </div>
        <p>{t(lang, 'audio.keepOpen')}</p>
        <p class="notice warn" data-no-backup hidden>
          {t(lang, 'audio.noBackup')}
        </p>
        <button type="button" class="btn primary" data-action="finish">
          ■ {t(lang, 'audio.finish')}
        </button>
        <div data-footage-slot />
      </div>

      <div data-step="cut">
        <p class="notice warn" data-cut-message>
          {format(t(lang, 'audio.cut'), { min: 23 })}
        </p>
        <div class="actions">
          <button type="button" class="btn record" data-action="continue">
            ● {t(lang, 'audio.continue')}
          </button>
          <button type="button" class="btn primary" data-action="upload-cut">
            {t(lang, 'audio.uploadWhatWeHave')}
          </button>
        </div>
        <div data-footage-slot />
      </div>

      <div data-step="uploading">
        <p>
          {t(lang, 'audio.uploading')} <strong data-uploading-name>{demo ? `${dates[0]}_1830.webm` : ''}</strong>
        </p>
        <progress max="100" value={demo ? 42 : 0} data-progress />
        <p class="percent" data-percent>
          {demo ? '42%' : '0%'}
        </p>
        <p class="notice warn" data-offline hidden>
          {t(lang, 'audio.offline')}
        </p>
      </div>

      <div data-step="done">
        <p class="notice">✓ {t(lang, 'audio.done')}</p>
        <button type="button" class="btn" data-action="another">
          {t(lang, 'audio.another')}
        </button>
      </div>

      <div data-step="error">
        <p class="notice error" data-error-message>
          {t(lang, 'audio.errorUpload')}
        </p>
        <div class="actions">
          <button type="button" class="btn primary" data-action="retry">
            {t(lang, 'audio.retry')}
          </button>
          <button type="button" class="btn" data-action="download" hidden={!demo}>
            {t(lang, 'audio.download')}
          </button>
        </div>
      </div>

      <div data-pending />

      <template data-footage-template>
        <FootageCard lang={lang} dates={dates} spots={spots} surfers={surfers} date={dates[0]} time="morning" removable />
      </template>
    </section>
  )
}

<script>
  import { init } from '../lib/audio/page';
  document.querySelectorAll<HTMLElement>('[data-audio]:not([data-demo])').forEach(init);
</script>

<style>
  .uploader {
    margin: var(--s-5) 0;
  }
  [data-step] {
    display: none;
  }
  /* The first visible step is not always the first child of .prose. */
  [data-step] > :first-child {
    margin-top: 0;
  }
  .uploader[data-state='login'] [data-step='login'],
  .uploader[data-state='ready'] [data-step='ready'],
  .uploader[data-state='recording'] [data-step='recording'],
  .uploader[data-state='cut'] [data-step='cut'],
  .uploader[data-state='uploading'] [data-step='uploading'],
  .uploader[data-state='done'] [data-step='done'],
  .uploader[data-state='error'] [data-step='error'] {
    display: block;
  }
  /* Pending recordings are only offered before starting something new. */
  .uploader:not([data-state='login']):not([data-state='ready']) [data-pending] {
    display: none;
  }
  .actions,
  .uploader :global(.actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: var(--s-4) 0;
  }
  .uploader :global(.pending-item .actions) {
    margin: var(--s-2) 0 0;
  }
  .uploader :global(.pending-item p) {
    margin: 0;
  }
  .field {
    display: grid;
    gap: var(--s-1);
    font: 13px var(--font-head);
    max-width: 20rem;
  }
  select {
    font: 16px var(--font-body);
    padding: var(--s-2);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--c-white);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }
  label.btn:focus-within {
    outline: 3px solid var(--c-sky);
    outline-offset: 2px;
  }
  .picked {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .clock {
    font: 48px/1 var(--font-strong);
    font-variant-numeric: tabular-nums;
    margin: var(--s-3) 0;
  }
  .level {
    height: 14px;
    border: var(--border);
    border-radius: 999px;
    overflow: hidden;
    background: var(--c-white);
  }
  .level span {
    display: block;
    height: 100%;
    background: var(--c-green);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.1s linear;
  }
  .percent {
    font-family: var(--font-strong);
  }
  .footage {
    border: 0;
    padding: 0;
    margin: var(--s-4) 0;
    min-width: 0;
  }
  legend {
    font: 15px var(--font-head);
    padding: 0;
  }
  .help {
    font-size: 14px;
    color: var(--c-muted);
  }
</style>
