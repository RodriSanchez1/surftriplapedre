---
import Avatar from './Avatar.astro';

interface Props {
  id: string;
  name: string;
  color: string;
  /** Without href (e.g. a coach, who has no page) the card is not a link. */
  href?: string;
  focus?: string;
}

const { id, name, color, href, focus } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card" href={href} style={`--accent: var(--c-${color})`}>
  <Avatar id={id} name="" size="md" />
  <span class="name">{name}</span>
  {focus && <span class="focus">{focus}</span>}
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    background: var(--c-ink);
    color: var(--c-white);
    border-radius: 10px;
    border-bottom: 6px solid var(--accent);
    padding: var(--s-3);
    text-decoration: none;
    transition: transform 0.12s;
  }
  a.card:hover {
    transform: translateY(-2px);
  }
  .name {
    font: 18px var(--font-head);
    color: var(--c-yellow);
    text-transform: uppercase;
  }
  .focus {
    font-size: 13px;
    line-height: 1.35;
    color: #e6e6e6;
  }
</style>
