---
import Avatar from './Avatar.astro';

interface Props {
  id: string;
  name: string;
  color: string;
  /** Without href (e.g. a coach with no profile) the card is not a link. */
  href?: string;
  focus?: string;
}

const { id, name, color, href, focus } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card" href={href} style={`--accent: var(--c-${color})`}>
  <span class="band" aria-hidden="true"></span>
  <span class="body">
    <Avatar id={id} name="" size="md" />
    <span class="name">{name}</span>
    {focus && <span class="focus">{focus}</span>}
  </span>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-paper);
    color: var(--c-ink);
    border: var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
  }
  /* Raised like every other link in the system (session days, buttons). */
  a.card {
    box-shadow: var(--shadow);
    transition:
      transform 0.12s,
      box-shadow 0.12s;
  }
  a.card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--c-ink);
  }
  a.card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--c-ink);
  }
  /* The surfer's color, cut on the hero's bolt angle. */
  .band {
    height: 52px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 55%, 0 100%);
  }
  /* Above the band: its clip-path paints it on top otherwise. */
  .body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: 0 var(--s-3) var(--s-3);
  }
  .body :global(.avatar) {
    margin: -40px 0 var(--s-2);
    border-color: var(--c-ink);
    box-shadow: 0 0 0 3px var(--c-paper);
  }
  .name {
    font: 18px/1.15 var(--font-head);
  }
  .focus {
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--c-muted);
  }
</style>
