---
/**
 * Design proposal: the speed menu and the volume control of the video review's transport.
 * A proposal page is built from the design system (tokens.css, global.css, the /design/ components) and is deleted
 * once the feature is built: from then on the code and /design/ show what exists.
 */
import BaseLayout from '../../../components/BaseLayout.astro';

const speeds = [1, 0.5, 0.25];
const vol = '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/>';
const muted = '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 9.5l5 5M21.5 9.5l-5 5"/>';
const fs = '<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/>';

type Volume = 'inline' | 'popover' | 'hover';
const variants: { id: Volume; title: string; text: string }[] = [
  {
    id: 'popover',
    title: 'Elegida: B sin “Silenciar” (30/10)',
    text: '🔊 abre hacia arriba la barra vertical de volumen. Con la barra abierta, tocar 🔊 silencia o devuelve el sonido; la barra queda atenuada en el nivel que tenía, y moverla devuelve el sonido. Se cierra tocando afuera o con Esc.',
  },
];
---

<BaseLayout title="Propuesta: velocidad y volumen" lang="es" team="Design system" langSwitch={false}>
  <main class="wrap">
    <h1 class="section-title">Propuesta: velocidad y volumen en el análisis de video</h1>
    <div class="prose card intro">
      <p>
        La velocidad pasa de tres botones (laptop) o un botón que rota (celular) a <strong>un solo botón con desplegable</strong>,
        igual en todas las pantallas. Se suma el <strong>volumen</strong>. El volumen es un botón 🔊 con su barra en un desplegable.
      </p>
      <p>
        Teclado: <kbd>←</kbd>/<kbd>→</kbd> un cuadro; mantenidas, cámara lenta a 0.25×. <kbd>N</kbd> / <kbd>Shift</kbd>+<kbd>N</kbd>
        &nbsp;clip siguiente o anterior. <kbd>↑</kbd>/<kbd>↓</kbd> volumen, <kbd>M</kbd> silencio.
      </p>
    </div>

    {
      variants.map((v) => (
        <section>
          <h2 class="section-title">{v.title}</h2>
          <p class="note">{v.text}</p>
          <div class="frames">
            {[
              { size: 'laptop', open: 'speed', mute: false },
              { size: 'laptop', open: 'volume', mute: false },
              { size: 'laptop', open: 'volume', mute: true },
              { size: 'phone', open: 'speed', mute: false },
              { size: 'phone', open: 'volume', mute: false },
            ].map((f) => (
                <figure class:list={['frame', f.size]}>
                  <figcaption>
                    {f.size === 'laptop' ? 'Laptop' : 'Celular'} ·{' '}
                    {f.open === 'speed' ? 'velocidad abierta' : v.id === 'popover' ? (f.mute ? 'volumen abierto, silenciado' : 'volumen abierto') : f.mute ? 'silenciado' : v.id === 'hover' ? 'mouse sobre 🔊' : 'volumen'}
                  </figcaption>
                  <div class="picture" />
                  <div class:list={['transport', f.size]}>
                    <div class="t-step">
                      <button type="button" class="btn small">|◀</button>
                      <button type="button" class="btn small">▶</button>
                      <button type="button" class="btn small">▶|</button>
                    </div>
                    <div class="t-seek">
                      <input type="range" class="seek" min="0" max="31" value="13.4" style="--played: 43%" aria-label="Línea de tiempo" />
                      <span class="readout">0:13.40 · 10:42:18</span>
                    </div>
                    <div class="t-opts">
                      <span class="anchor">
                        <button type="button" class="btn small speed" aria-expanded={f.open === 'speed' ? 'true' : 'false'}>
                          0.5× <span class="caret">▾</span>
                        </button>
                        {f.open === 'speed' && (
                          <span class="menu" role="menu" aria-label="Velocidad">
                            {speeds.map((r) => (
                              <button type="button" class="menu-item" role="menuitemradio" aria-checked={r === 0.5 ? 'true' : 'false'}>
                                {r}×
                              </button>
                            ))}
                          </span>
                        )}
                      </span>
                      <span class:list={['volume', v.id, { open: f.open === 'volume' }]}>
                        <button type="button" class="btn small icon-btn" aria-pressed={f.mute ? 'true' : 'false'} aria-label="Silenciar">
                          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={f.mute ? muted : vol} />
                        </button>
                        {f.size === 'laptop' && v.id !== 'popover' && (v.id === 'inline' || f.open === 'volume') && (
                          <input type="range" class="seek vol" min="0" max="1" step="0.05" value="0.7" style="--played: 70%" aria-label="Volumen" />
                        )}
                        {v.id === 'popover' && f.open === 'volume' && (
                          <span class:list={['menu', 'vol-menu', { muted: f.mute }]}>
                            <input type="range" class="seek vol vertical" min="0" max="1" step="0.05" value="0.7" style="--played: 70%" aria-label="Volumen" />
                          </span>
                        )}
                      </span>
                      <button type="button" class="btn small icon-btn" aria-label="Pantalla completa">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={fs} />
                      </button>
                    </div>
                  </div>
                </figure>
              ))}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  main {
    --hit: 44px;
    padding-bottom: var(--s-6);
  }
  .intro {
    padding: var(--s-4);
  }
  .note {
    max-width: 60ch;
    margin: 0 0 var(--s-3);
  }
  .frames {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: flex-start;
  }
  .frame {
    margin: 0;
    padding: var(--s-3);
    background: var(--c-orange);
    border: var(--border);
    border-radius: var(--radius);
  }
  .frame.laptop {
    width: 900px;
    max-width: 100%;
  }
  .frame.phone {
    width: 390px;
  }
  figcaption {
    font: 14px var(--font-head);
    margin-bottom: var(--s-2);
  }
  .picture {
    height: 150px;
    margin-bottom: var(--s-3);
    background: linear-gradient(var(--c-sky) 60%, #e8d5a3 60%);
    border: var(--border);
    border-radius: var(--radius);
  }

  /* The transport as it is in VideoReview.astro, with the speed menu and the volume. */
  .transport {
    display: grid;
    align-items: center;
    gap: var(--s-1) var(--s-2);
  }
  .transport.laptop {
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'step seek opts';
    gap: var(--s-3);
  }
  .transport.phone {
    grid-template-columns: auto 1fr;
    grid-template-areas: 'seek seek' 'step opts';
  }
  .t-step {
    grid-area: step;
  }
  .t-seek {
    grid-area: seek;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
  }
  .t-opts {
    grid-area: opts;
    justify-self: end;
  }
  /* Wide enough that a button's shadow, even lifted on hover, never touches the next one. */
  .t-step,
  .t-opts,
  .volume {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .readout {
    font: 14px var(--font-strong);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .speed {
    min-width: 4.5rem;
  }
  .caret {
    font-size: 11px;
  }
  .speed[aria-expanded='true'] {
    background: var(--c-yellow);
  }
  .anchor,
  .volume {
    position: relative;
  }
  .menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + var(--s-2));
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 6rem;
    padding: var(--s-1);
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .menu-item {
    min-height: var(--hit);
    padding: 0 var(--s-3);
    font: 14px/1 var(--font-head);
    color: var(--c-ink);
    text-align: left;
    background: var(--c-white);
    border: 2px solid var(--c-ink);
    border-radius: 6px;
    cursor: pointer;
  }
  .menu-item[aria-checked='true'] {
    background: var(--c-yellow);
  }
  .menu-item[aria-checked='true']::before {
    content: '✓ ';
  }
  .volume [aria-pressed='true'] {
    background: var(--c-yellow);
  }
  .vol-menu {
    align-items: center;
    min-width: 0;
  }
  .vol-menu.muted .vol {
    opacity: 0.4;
  }

  /* The timeline's track and knob (VideoReview.astro), and a smaller one for the volume. */
  .seek {
    --track: 12px;
    --knob: 28px;
    flex: 1;
    min-width: 0;
    height: var(--hit);
    margin: 0;
    background: none;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }
  .seek::-webkit-slider-runnable-track {
    height: var(--track);
    box-sizing: border-box;
    border: 2px solid var(--c-ink);
    border-radius: 999px;
    background: linear-gradient(to right, var(--c-red) var(--played, 0%), var(--c-white) var(--played, 0%));
  }
  .seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: var(--knob);
    height: var(--knob);
    box-sizing: border-box;
    margin-top: calc((var(--track) - var(--knob)) / 2);
    border: 3px solid var(--c-ink);
    border-radius: 50%;
    background: var(--c-yellow);
  }
  .vol {
    --track: 10px;
    --knob: 20px;
    flex: none;
    width: 6rem;
  }
  .vol.vertical {
    writing-mode: vertical-lr;
    direction: rtl;
    width: var(--hit);
    height: 7rem;
  }
  .vol.vertical::-webkit-slider-runnable-track {
    width: var(--track);
    height: auto;
    background: linear-gradient(to top, var(--c-red) var(--played, 0%), var(--c-white) var(--played, 0%));
  }
  .vol.vertical::-webkit-slider-thumb {
    margin-top: 0;
    margin-left: calc((var(--track) - var(--knob)) / 2);
  }
</style>
