---
/**
 * Design system catalog. It is not linked from the navigation.
 * Before creating a new component, check whether it already exists here. If you create one, add it here.
 */
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import Bolt from '../components/Bolt.astro';
import DayCell from '../components/DayCell.astro';
import SurferCard from '../components/SurferCard.astro';
import ToolLink from '../components/ToolLink.astro';
import Avatar from '../components/Avatar.astro';
import FocusBlock from '../components/FocusBlock.astro';
import CaptureGrid from '../components/CaptureGrid.astro';
import InsightBlock from '../components/InsightBlock.astro';
import TranslationBadge from '../components/TranslationBadge.astro';
import AudioUploader from '../components/AudioUploader.astro';
import FootageList from '../components/FootageList.astro';
import VideoReview from '../components/VideoReview.astro';
import TourOverlay from '../components/TourOverlay.astro';
import ReviewKeys from '../components/ReviewKeys.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { cursorSvg, ICONS, type IconName } from '../lib/review/icons';
import { ACCENTS } from '../content.config';
import { renderCard, type Card } from '../lib/og/card';

const colors = [...new Set(['orange', 'red', 'yellow', 'ink', 'paper', 'white', 'muted', ...ACCENTS])];
const fonts = [
  ['--font-display', 'Bungee Shade · page titles'],
  ['--font-head', 'Bungee · headings and labels'],
  ['--font-strong', 'Archivo Black · highlighted data'],
  ['--font-body', 'system-ui · body text'],
];
const audioStates = ['login', 'ready', 'recording', 'cut', 'uploading', 'done', 'error'] as const;
const audioDemo = { driveFolder: 'demo', googleClientId: 'demo.apps.googleusercontent.com', contact: 'el organizador' };
const demoDates = ['2026-01-05', '2026-01-06', '2026-01-07'];
const demoSpots = ['Playa A', 'Playa B'];
/** Link preview images (src/lib/og/), rendered here with demo data. */
const demoCards: Card[] = [
  {
    title: 'Surftrip Demo',
    size: 'hero',
    team: 'Team Demo',
    facts: [
      { icon: 'place', text: 'Lugar del trip' },
      { icon: 'dates', text: '5 ene – 12 ene' },
    ],
  },
  { title: 'Juan', subtitle: 'Foco actual: mirar adonde quiere ir', team: 'Team Demo', avatar: { id: 'juan', color: 'red' } },
];
const cardImages = await Promise.all(demoCards.map(async (c) => `data:image/png;base64,${(await renderCard(c)).toString('base64')}`));
const demoSurfers = [
  { id: 'juan', name: 'Juan', color: 'red' },
  { id: 'ana', name: 'Ana', color: 'sky' },
  { id: 'leo', name: 'Leo', color: 'green' },
];

const toolIcons = Object.keys(ICONS) as IconName[];
const cursorTools = ['pen', 'arrow', 'freeArrow', 'circle'] as const;
/** The cursors drawn with the tokens (the page builds them with the computed colours). */
const cursorColors = { ink: 'var(--c-ink)', paper: 'var(--c-paper)', accent: 'var(--c-yellow)' };
---

<BaseLayout title="Design system" lang="es" team="Design system" langSwitch={false}>
  <BoltBand title="Design system" subtitle="Site tokens and components" />

  <div class="wrap">
    <h2 class="section-title">Colors</h2>
    <div class="swatches">
      {
        colors.map((c) => (
          <div class="swatch">
            <span style={`background: var(--c-${c})`} />
            <code>--c-{c}</code>
          </div>
        ))
      }
      <div class="swatch">
        <span class="ring-sample" />
        <code>--focus-ring</code>
      </div>
    </div>

    <h2 class="section-title">Typography</h2>
    <div class="prose">
      {fonts.map(([v, label]) => <p style={`font-family: var(${v}); font-size: 22px; margin: 8px 0`}>{label}</p>)}
    </div>

    <h2 class="section-title">DayCell</h2>
    <div class="row">
      <DayCell lang="es" date="2026-10-24" weekday={6} state="past" showMonth />
      <DayCell lang="es" date="2026-10-25" weekday={0} state="past" activity="Pasado, con sesión" href="#" />
      <DayCell lang="es" date="2026-10-26" weekday={1} state="today" activity="Hoy, con sesión" href="#" />
      <DayCell lang="es" date="2026-10-27" weekday={2} state="future" activity="Futuro con plan" />
      <DayCell lang="es" date="2026-10-28" weekday={3} state="future" />
      <DayCell lang="es" date="2026-10-29" weekday={4} state="future" activity="Sesión" href="#" />
      <DayCell lang="es" date="2026-11-01" weekday={0} state="future" showMonth />
    </div>

    <h2 class="section-title">BoltBand hero with facts</h2>
  </div>
  <BoltBand
    size="hero"
    title="Surftrip Demo"
    facts={[
      { icon: 'place', text: 'Lugar del trip' },
      { icon: 'dates', text: '5 ene → 12 ene' },
    ]}
  />
  <div class="wrap">
    <h2 class="section-title">Link preview (og:image)</h2>
    <p class="prose">What WhatsApp, Discord and Telegram show when a link is shared. Each page passes its own card from src/lib/og/meta.ts; the images are generated at build time in /og/.</p>
    <div class="og-cards">
      {cardImages.map((src, i) => <img src={src} alt={demoCards[i].title} width="600" height="315" />)}
    </div>

    <h2 class="section-title">Bolt</h2>
    <div class="row" style="color: var(--c-red)">
      <Bolt size={14} />
      <Bolt size={24} />
      <Bolt size={40} />
    </div>

    <h2 class="section-title">SurferCard and Avatar</h2>
    <div class="row">
      {
        ACCENTS.map((color) => (
          <div style="width: 160px">
            <SurferCard id="juan" name={color} color={color} href="#" focus="Foco principal de ejemplo" />
          </div>
        ))
      }
      <div style="width: 160px">
        <SurferCard id="douglas" name="Sin link (coach)" color="sky" />
      </div>
    </div>
    <div class="row">
      <Avatar id="juan" name="Juan" size="sm" />
      <Avatar id="juan" name="Juan" size="md" />
      <Avatar id="juan" name="Juan" size="lg" />
    </div>

    <h2 class="section-title">ToolLink</h2>
    <div style="max-width: 420px">
      <ToolLink href="#" icon="🎬" title="Análisis de video" text="Una herramienta del coach, con una línea que dice para qué sirve." />
    </div>

    <h2 class="section-title">FocusBlock</h2>
    <FocusBlock lang="es" focus="Manos al centro en el drop" secondaryFocus="Subir después de la base" cue="Bajé, llegué a la base, tengo que subir" />

    <h2 class="section-title">InsightBlock and TranslationBadge</h2>
    <InsightBlock heading="With link" href="#" linkText="Ver la sesión completa">
      <p>Insight text on paper.</p>
    </InsightBlock>
    <InsightBlock heading="With translation fallback" fallback>
      <p>Shown in Spanish because the .pt.md is missing.</p>
    </InsightBlock>
    <p><TranslationBadge /></p>

    <h2 class="section-title">Capture and CaptureGrid</h2>
    <CaptureGrid
      lang="es"
      date="_design"
      captures={[
        { id: 'example', caption: 'El brazo delantero guía el giro', wave: '10:42', day: '2026-01-05' },
        { id: 'example', caption: 'Without wave time: just the caption' },
      ]}
    />

    <h2 class="section-title">Pressing</h2>
    <div class="prose">
      <p>
        <code>.btn</code> and <code>.pressable</code> (session days, linked cards) share one pattern. On hover the surface lifts
        by half its shadow (<code>--lift</code>) and the shadow grows by the same, so its foot does not move. Pressing pushes it in.
        Text links only change the underline color.
      </p>
      <div class="row">
        <button type="button" class="btn primary">Rest</button>
        <button type="button" class="btn primary" data-demo="hover">Hover</button>
        <button type="button" class="btn primary" data-demo="press">Press</button>
      </div>
    </div>

    <h2 class="section-title">FootageList</h2>
    <FootageList
      lang="es"
      surfers={demoSurfers}
      footage={[
        { date: '2026-01-05', time: 'afternoon', spot: 'Playa A', surfers: ['juan', 'leo'] },
        { date: '2026-01-06', time: 'morning', surfers: ['juan', 'ana', 'leo'] },
      ]}
    />

    <h2 class="section-title">Buttons, notices, chips and progress</h2>
    <div class="prose">
      <div class="row">
        <button type="button" class="btn">.btn</button>
        <button type="button" class="btn primary">.btn.primary</button>
        <button type="button" class="btn record">● .btn.record</button>
        <button type="button" class="btn small">.btn.small</button>
        <button type="button" class="btn" disabled>disabled</button>
      </div>
      <p class="notice">.notice</p>
      <p class="notice warn">.notice.warn</p>
      <p class="notice error">.notice.error</p>
      <div class="row">
        <span class="chip" style="--accent: var(--c-sky)">.chip</span>
        <span class="chip out">.chip.out</span>
        <label class="chip" style="--accent: var(--c-green)"><input type="checkbox" checked /> checkbox</label>
      </div>
      <progress max="100" value="42"></progress>
    </div>

    <h2 class="section-title">AudioUploader</h2>
    {
      audioStates.map((state) => (
        <>
          <p class="state">{state}</p>
          <AudioUploader
            lang="es"
            dates={demoDates}
            timeZone="UTC"
            spots={demoSpots}
            surfers={demoSurfers}
            audio={audioDemo}
            demo={state}
          />
        </>
      ))
    }
    <p class="state">not configured</p>
    <AudioUploader lang="es" dates={demoDates} timeZone="UTC" />

    <h2 class="section-title">VideoReview</h2>
    <p class="state">app screen with a fixed-height frame here: clip open, arrow tool, recording audio, the clip tags open</p>
  </div>
  <div class="wide-demo">
    <div class="review-frame">
      <VideoReview lang="es" dates={demoDates} timeZone="UTC" surfers={demoSurfers} audio={audioDemo} demo />
    </div>
  </div>
  <div class="wrap">
    <p class="state">pending upload: ⬆ Subir opens this panel, with filters by surfer, landscape and extras, the captures, the tagged clips and the clips the upload will delete</p>
  </div>
  <div class="wide-demo">
    <div class="review-frame">
      <VideoReview lang="es" dates={demoDates} timeZone="UTC" surfers={demoSurfers} audio={audioDemo} demo="pending" />
    </div>
  </div>
  <div class="wrap">
    <p class="state">login: covers the screen until the coach signs in with a Google account that can see the trip's folder</p>
  </div>
  <div class="wide-demo">
    <div class="review-frame short">
      <VideoReview lang="es" dates={demoDates} timeZone="UTC" surfers={demoSurfers} audio={audioDemo} demo="login" />
    </div>
  </div>
  <div class="wrap">
    <h2 class="section-title">TourOverlay</h2>
    <p class="state">guided tour of /review/: the screen dims, the control gets an ink and yellow ring and the card explains it (step "capture"; on the page it is a modal dialog placed by tour-page.ts)</p>
    <TourOverlay lang="es" demo="capture" />
    <h2 class="section-title">ReviewKeys</h2>
    <p class="state">keyboard shortcuts of /review/: the ⌨ button next to ? opens them in a modal dialog (Esc, ✕ or a click outside close it); not shown on touch screens</p>
    <ReviewKeys lang="es" demo />

    <h2 class="section-title">ToolIcon</h2>
    <p class="state">icons of the drawing rail on /review/ (src/lib/review/icons.ts)</p>
    <div class="row">
      {
        toolIcons.map((name) => (
          <figure class="icon-sample">
            <ToolIcon name={name} />
            <figcaption><code>{name}</code></figcaption>
          </figure>
        ))
      }
    </div>
    <p class="state">drawing cursors (32 px, shown at double size here): they take the colour in use (yellow here)</p>
    <div class="row cursor-samples">
      {
        cursorTools.map((tool) => (
          <figure class="icon-sample">
            <span class="cursor-sample" set:html={cursorSvg(tool, cursorColors)} />
            <figcaption><code>{tool}</code></figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .wide-demo {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--s-4);
  }
  /* The review screen fills its parent; on this page the parent has a fixed height instead of 100dvh. */
  .review-frame {
    height: 46rem;
    background: var(--c-orange);
    border: var(--border);
    border-radius: var(--radius);
  }
  .review-frame.short {
    height: 24rem;
  }
  .icon-sample {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-1);
    padding: var(--s-2) var(--s-3);
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
  }
  .icon-sample code {
    font-size: 12px;
  }
  /* On the picture's own background, so the paper halo and the ink outline both show. */
  .cursor-samples .icon-sample {
    background: var(--c-ink);
    color: var(--c-white);
  }
  .cursor-sample :global(svg) {
    display: block;
    width: 64px;
    height: 64px;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--s-3);
  }
  .swatch {
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .swatch span {
    display: block;
    height: 56px;
    border-bottom: var(--border);
  }
  /* Keyboard focus ring as the app screens draw it: on the orange page, offset from the control. */
  .swatch span.ring-sample {
    background: var(--c-orange)
      linear-gradient(var(--c-white), var(--c-white)) center / calc(100% - 56px) calc(100% - 28px) no-repeat;
    outline: 3px solid var(--focus-ring);
    outline-offset: -11px;
  }
  .swatch code {
    display: block;
    padding: var(--s-2);
    font-size: 12px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: flex-start;
    margin-bottom: var(--s-3);
  }
  .og-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-4);
  }
  .og-cards img {
    width: 100%;
    height: auto;
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .state {
    font: 13px var(--font-head);
    margin: var(--s-5) 0 0;
  }
</style>
