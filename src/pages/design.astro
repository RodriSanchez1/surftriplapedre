---
/**
 * Design system catalog. It is not linked from the navigation.
 * Before creating a new component, check whether it already exists here. If you create one, add it here.
 */
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import Bolt from '../components/Bolt.astro';
import DayCell from '../components/DayCell.astro';
import SurferCard from '../components/SurferCard.astro';
import Avatar from '../components/Avatar.astro';
import FocusBlock from '../components/FocusBlock.astro';
import InsightBlock from '../components/InsightBlock.astro';
import TranslationBadge from '../components/TranslationBadge.astro';
import AudioUploader from '../components/AudioUploader.astro';
import { ACCENTS } from '../content.config';

const colors = [...new Set(['orange', 'red', 'yellow', 'ink', 'paper', 'white', 'muted', ...ACCENTS])];
const fonts = [
  ['--font-display', 'Bungee Shade · page titles'],
  ['--font-head', 'Bungee · headings and labels'],
  ['--font-strong', 'Archivo Black · highlighted data'],
  ['--font-body', 'system-ui · body text'],
];
const audioStates = ['login', 'ready', 'recording', 'cut', 'uploading', 'done', 'error'] as const;
const audioDemo = { driveFolder: 'demo', googleClientId: 'demo.apps.googleusercontent.com', contact: 'el organizador' };
const demoDates = ['2026-01-05', '2026-01-06', '2026-01-07'];
---

<BaseLayout title="Design system" lang="es" team="Design system" langSwitch={false}>
  <BoltBand title="Design system" subtitle="Site tokens and components" />

  <div class="wrap">
    <h2 class="section-title">Colors</h2>
    <div class="swatches">
      {
        colors.map((c) => (
          <div class="swatch">
            <span style={`background: var(--c-${c})`} />
            <code>--c-{c}</code>
          </div>
        ))
      }
    </div>

    <h2 class="section-title">Typography</h2>
    <div class="prose">
      {fonts.map(([v, label]) => <p style={`font-family: var(${v}); font-size: 22px; margin: 8px 0`}>{label}</p>)}
    </div>

    <h2 class="section-title">DayCell</h2>
    <div class="row">
      <DayCell lang="es" date="2026-10-24" weekday={6} state="past" showMonth />
      <DayCell lang="es" date="2026-10-25" weekday={0} state="past" activity="Pasado, con sesión" href="#" />
      <DayCell lang="es" date="2026-10-26" weekday={1} state="today" activity="Hoy, con sesión" href="#" />
      <DayCell lang="es" date="2026-10-27" weekday={2} state="future" activity="Futuro con plan" />
      <DayCell lang="es" date="2026-10-28" weekday={3} state="future" />
      <DayCell lang="es" date="2026-10-29" weekday={4} state="future" activity="Sesión" href="#" />
      <DayCell lang="es" date="2026-11-01" weekday={0} state="future" showMonth />
    </div>

    <h2 class="section-title">BoltBand hero with facts</h2>
  </div>
  <BoltBand
    size="hero"
    title="Surftrip Demo"
    facts={[
      { icon: 'place', text: 'Lugar del trip' },
      { icon: 'dates', text: '5 ene → 12 ene' },
    ]}
  />
  <div class="wrap">
    <h2 class="section-title">Bolt</h2>
    <div class="row" style="color: var(--c-red)">
      <Bolt size={14} />
      <Bolt size={24} />
      <Bolt size={40} />
    </div>

    <h2 class="section-title">SurferCard and Avatar</h2>
    <div class="row">
      {
        ACCENTS.map((color) => (
          <div style="width: 160px">
            <SurferCard id="juan" name={color} color={color} href="#" focus="Foco principal de ejemplo" />
          </div>
        ))
      }
      <div style="width: 160px">
        <SurferCard id="douglas" name="Sin link (coach)" color="sky" />
      </div>
    </div>
    <div class="row">
      <Avatar id="juan" name="Juan" size="sm" />
      <Avatar id="juan" name="Juan" size="md" />
      <Avatar id="juan" name="Juan" size="lg" />
    </div>

    <h2 class="section-title">FocusBlock</h2>
    <FocusBlock lang="es" focus="Manos al centro en el drop" secondaryFocus="Subir después de la base" cue="Bajé, llegué a la base, tengo que subir" />

    <h2 class="section-title">InsightBlock and TranslationBadge</h2>
    <InsightBlock heading="With link" href="#" linkText="Ver la sesión completa">
      <p>Insight text on paper.</p>
    </InsightBlock>
    <InsightBlock heading="With translation fallback" fallback>
      <p>Shown in Spanish because the .pt.md is missing.</p>
    </InsightBlock>
    <p><TranslationBadge /></p>

    <h2 class="section-title">Pressing</h2>
    <div class="prose">
      <p>
        <code>.btn</code> and <code>.pressable</code> (session days, linked cards) share one pattern. On hover the surface lifts
        by half its shadow (<code>--lift</code>) and the shadow grows by the same, so its foot does not move. Pressing pushes it in.
        Text links only change the underline color.
      </p>
      <div class="row">
        <button type="button" class="btn primary">Rest</button>
        <button type="button" class="btn primary" data-demo="hover">Hover</button>
        <button type="button" class="btn primary" data-demo="press">Press</button>
      </div>
    </div>

    <h2 class="section-title">Buttons, notices and progress</h2>
    <div class="prose">
      <div class="row">
        <button type="button" class="btn">.btn</button>
        <button type="button" class="btn primary">.btn.primary</button>
        <button type="button" class="btn record">● .btn.record</button>
        <button type="button" class="btn" disabled>disabled</button>
      </div>
      <p class="notice">.notice</p>
      <p class="notice warn">.notice.warn</p>
      <p class="notice error">.notice.error</p>
      <progress max="100" value="42"></progress>
    </div>

    <h2 class="section-title">AudioUploader</h2>
    {
      audioStates.map((state) => (
        <>
          <p class="state">{state}</p>
          <AudioUploader lang="es" dates={demoDates} timeZone="UTC" audio={audioDemo} demo={state} />
        </>
      ))
    }
    <p class="state">not configured</p>
    <AudioUploader lang="es" dates={demoDates} timeZone="UTC" />
  </div>
</BaseLayout>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--s-3);
  }
  .swatch {
    background: var(--c-paper);
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .swatch span {
    display: block;
    height: 56px;
    border-bottom: var(--border);
  }
  .swatch code {
    display: block;
    padding: var(--s-2);
    font-size: 12px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: flex-start;
    margin-bottom: var(--s-3);
  }
  .state {
    font: 13px var(--font-head);
    margin: var(--s-5) 0 0;
  }
</style>
