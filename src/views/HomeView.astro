---
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import TripCalendar from '../components/TripCalendar.astro';
import SurferCard from '../components/SurferCard.astro';
import { loadSite } from '../lib/content';
import { dayMonth } from '../lib/calendar';
import { pathFor, t, type Lang } from '../lib/i18n';
import { insightsForSurfer } from '../lib/localized';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const { trip, days, surfers, insights } = await loadSite();
const dates = `${dayMonth(trip.startDate)} → ${dayMonth(trip.endDate)}`;
---

<BaseLayout title={trip.name} lang={lang} team={trip.team}>
  <BoltBand
    size="hero"
    kicker={trip.team}
    title={trip.name}
    subtitle={`${trip.location} · ${dates} · ${t(lang, 'home.coach')}: ${trip.coach}`}
  />

  <div class="wrap">
    <h2 class="section-title">{t(lang, 'home.calendar')}</h2>
    <TripCalendar lang={lang} startDate={trip.startDate} endDate={trip.endDate} timeZone={trip.timeZone} days={days} />

    <h2 class="section-title">{t(lang, 'home.team')}</h2>
    <div class="roster">
      {
        surfers.map((s) => (
          <SurferCard
            id={s.id}
            name={s.data.name}
            color={s.data.color}
            href={pathFor(lang, `/surfers/${s.id}/`, base)}
            focus={insightsForSurfer(insights, s.id, lang)[0]?.entry.data.focus}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>

{
  lang === 'es' && (
    <script is:inline define:vars={{ ptHome: pathFor('pt', '/', base) }}>
      // Compatibility with old links like ...?lang=pt
      if (new URLSearchParams(location.search).get('lang') === 'pt') location.replace(ptHome);
    </script>
  )
}

<style>
  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--s-3);
  }
</style>
