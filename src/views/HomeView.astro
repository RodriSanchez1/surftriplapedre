---
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import TripCalendar from '../components/TripCalendar.astro';
import SurferCard from '../components/SurferCard.astro';
import ToolLink from '../components/ToolLink.astro';
import { loadSite } from '../lib/content';
import { pathFor, shortDate, t, type Lang } from '../lib/i18n';
import { insightsForSurfer, pickLang } from '../lib/localized';
import { homeMeta } from '../lib/og/meta';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = await loadSite();
const { trip, days, surfers, coaches, coachProfiles, insights } = site;
const hasProfile = (id: string) => pickLang(coachProfiles, id, lang) !== undefined;
const dates = `${shortDate(lang, trip.startDate)} → ${shortDate(lang, trip.endDate)}`;
---

<BaseLayout title={trip.name} lang={lang} team={trip.team} siteName={trip.name} description={homeMeta(site, lang).description}>
  <BoltBand
    size="hero"
    title={trip.name}
    facts={[
      { icon: 'place', text: trip.location },
      { icon: 'dates', text: dates },
    ]}
  />

  <div class="wrap">
    <h2 class="section-title">{t(lang, 'home.calendar')}</h2>
    <TripCalendar lang={lang} startDate={trip.startDate} endDate={trip.endDate} timeZone={trip.timeZone} days={days} />

    <h2 class="section-title">{t(lang, 'home.team')}</h2>
    <div class="roster">
      {
        surfers.map((s) => (
          <SurferCard
            id={s.id}
            name={s.data.name}
            color={s.data.color}
            href={pathFor(lang, `/surfers/${s.id}/`, base)}
            focus={insightsForSurfer(insights, s.id, lang)[0]?.entry.data.focus}
          />
        ))
      }
    </div>

    {
      coaches.length > 0 && (
        <>
          <h2 class="section-title">{t(lang, 'home.coaches')}</h2>
          <div class="roster">
            {coaches.map((c) => (
              <SurferCard
                id={c.id}
                name={c.data.name}
                color={c.data.color}
                href={hasProfile(c.id) ? pathFor(lang, `/coaches/${c.id}/`, base) : undefined}
              />
            ))}
          </div>
        </>
      )
    }

    <h2 class="section-title">{t(lang, 'home.tools')}</h2>
    <div class="tools">
      <ToolLink
        href={pathFor(lang, '/review/', base)}
        icon="🎬"
        title={t(lang, 'review.title')}
        text={t(lang, 'home.reviewText')}
      />
    </div>
  </div>
</BaseLayout>

{
  lang === 'es' && (
    <script is:inline define:vars={{ ptHome: pathFor('pt', '/', base) }}>
      // Compatibility with old links like ...?lang=pt
      if (new URLSearchParams(location.search).get('lang') === 'pt') location.replace(ptHome);
    </script>
  )
}

<style>
  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--s-3);
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--s-3);
  }
</style>
