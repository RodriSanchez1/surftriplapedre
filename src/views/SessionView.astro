---
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import InsightBlock from '../components/InsightBlock.astro';
import TranslationBadge from '../components/TranslationBadge.astro';
import CaptureGrid from '../components/CaptureGrid.astro';
import Avatar from '../components/Avatar.astro';
import FootageList from '../components/FootageList.astro';
import { loadSite } from '../lib/content';
import { sessionMeta } from '../lib/og/meta';
import { dayMonth } from '../lib/calendar';
import { pathFor, t, type Lang } from '../lib/i18n';
import { insightsForSession, pickLang } from '../lib/localized';
import { linkReviewMoments } from '../lib/review/recording';

interface Props {
  lang: Lang;
  date: string;
}

const { lang, date } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = await loadSite();
const { trip, surfers, sessions, insights } = site;
const meta = sessionMeta(site, lang, date);

const session = pickLang(sessions, date, lang);
if (!session) throw new Error(`src/content/sessions/${date}.es.md does not exist`);
/** The review recording is the same in every language; npm run recording writes it into the Spanish file too. */
const recording = pickLang(sessions, date, 'es')?.entry.data.recording;
const summaryHtml = linkReviewMoments(session.entry.rendered?.html ?? '', recording);

const names = new Map(surfers.map((s) => [s.id, s.data.name]));
const items = insightsForSession(insights, date, lang, surfers.map((s) => s.id)).map((l) => ({
  ...l,
  html: linkReviewMoments(l.entry.rendered?.html ?? '', recording),
}));
---

<BaseLayout title={`${t(lang, 'session.title')} ${dayMonth(date)} · ${trip.name}`} lang={lang} team={trip.team} siteName={trip.name} description={meta.description} image={meta.key}>
  <BoltBand title={`${t(lang, 'session.title')} ${dayMonth(date)}`} subtitle={session.entry.data.title} />

  <div class="wrap">
    {
      session.entry.data.footage.length > 0 && (
        <>
          <h2 class="section-title">{t(lang, 'footage.title')}</h2>
          <FootageList
            lang={lang}
            footage={session.entry.data.footage}
            surfers={surfers.map((s) => ({ id: s.id, name: s.data.name, color: s.data.color }))}
          />
        </>
      )
    }

    <h2 class="section-title">{t(lang, 'session.summary')}</h2>
    <section class="prose">
      {session.fallback && <TranslationBadge />}
      <Fragment set:html={summaryHtml} />
    </section>

    <h2 class="section-title">{t(lang, 'session.plan')}</h2>
    <div class="prose table-wrap">
      {session.entry.data.planNote && <p>{session.entry.data.planNote}</p>}
      <table>
        <thead>
          <tr>
            <th>{t(lang, 'table.surfer')}</th>
            <th>{t(lang, 'focus.main')}</th>
            <th>{t(lang, 'focus.secondary')}</th>
            <th>{t(lang, 'focus.cue')}</th>
          </tr>
        </thead>
        <tbody>
          {
            items.map(({ entry }) => (
              <tr>
                <td><a href={`#${entry.data.surfer}`}>{names.get(entry.data.surfer)}</a></td>
                <td data-k={t(lang, 'focus.main')}>{entry.data.focus}</td>
                <td data-k={t(lang, 'focus.secondary')}>{entry.data.secondaryFocus}</td>
                <td data-k={t(lang, 'focus.cue')}>“{entry.data.cue}”</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      session.entry.data.logistics.length > 0 && (
        <>
          <h2 class="section-title">{t(lang, 'session.logistics')}</h2>
          <ul class="prose">
            {session.entry.data.logistics.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )
    }

    <h2 class="section-title">{t(lang, 'session.surfers')}</h2>
    {
      items.map(({ entry, fallback, html }) => (
        <InsightBlock
          id={entry.data.surfer}
          heading={names.get(entry.data.surfer) ?? entry.data.surfer}
          fallback={fallback}
          href={pathFor(lang, `/surfers/${entry.data.surfer}/`, base)}
          linkText={names.get(entry.data.surfer)}
        >
          <Avatar slot="media" id={entry.data.surfer} name="" size="sm" />
          <Fragment set:html={html} />
          <CaptureGrid lang={lang} date={entry.data.date} captures={entry.data.captures} recording={recording} />
        </InsightBlock>
      ))
    }
  </div>
</BaseLayout>
