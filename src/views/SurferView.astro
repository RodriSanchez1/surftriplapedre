---
import { render } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import Avatar from '../components/Avatar.astro';
import FocusBlock from '../components/FocusBlock.astro';
import InsightBlock from '../components/InsightBlock.astro';
import { loadSite } from '../lib/content';
import { dayMonth } from '../lib/calendar';
import { pathFor, t, type Lang } from '../lib/i18n';
import { insightsForSurfer } from '../lib/localized';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const base = import.meta.env.BASE_URL;
const { trip, surfers, insights } = await loadSite();

const surfer = surfers.find((s) => s.id === id);
if (!surfer) throw new Error(`Surfer "${id}" is not in surfers.yaml`);

const items = await Promise.all(
  insightsForSurfer(insights, id, lang).map(async (l) => ({ ...l, Content: (await render(l.entry)).Content })),
);
const current = items[0]?.entry.data;
---

<BaseLayout title={`${surfer.data.name} · ${trip.name}`} lang={lang} team={trip.team}>
  <BoltBand kicker={trip.team} title={surfer.data.name}>
    <div slot="media" style={`--accent: var(--c-${surfer.data.color})`}>
      <Avatar id={id} name="" size="lg" />
    </div>
  </BoltBand>

  <div class="wrap">
    <h2 class="section-title">{t(lang, 'surfer.current')}</h2>
    {
      current ? (
        <FocusBlock lang={lang} focus={current.focus} secondaryFocus={current.secondaryFocus} cue={current.cue} />
      ) : (
        <p class="prose">{t(lang, 'surfer.none')}</p>
      )
    }

    {items.length > 0 && <h2 class="section-title">{t(lang, 'surfer.history')}</h2>}
    {
      items.map(({ entry, fallback, Content }) => (
        <InsightBlock
          heading={`${t(lang, 'session.title')} ${dayMonth(entry.data.date)}`}
          fallback={fallback}
          href={pathFor(lang, `/sessions/${entry.data.date}/`, base)}
          linkText={t(lang, 'surfer.seeSession')}
        >
          <Content />
        </InsightBlock>
      ))
    }
  </div>
</BaseLayout>
