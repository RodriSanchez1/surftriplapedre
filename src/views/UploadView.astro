---
import BaseLayout from '../components/BaseLayout.astro';
import BoltBand from '../components/BoltBand.astro';
import AudioUploader from '../components/AudioUploader.astro';
import { loadSite } from '../lib/content';
import { tripDates } from '../lib/calendar';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { trip, surfers } = await loadSite();
---

<BaseLayout title={`${t(lang, 'audio.title')} · ${trip.name}`} lang={lang} team={trip.team} siteName={trip.name} description={t(lang, 'audio.intro')}>
  <BoltBand title={t(lang, 'audio.title')} subtitle={t(lang, 'audio.intro')} />
  <div class="wrap">
    <AudioUploader
      lang={lang}
      dates={tripDates(trip.startDate, trip.endDate)}
      timeZone={trip.timeZone}
      spots={trip.spots}
      surfers={surfers.map((s) => ({ id: s.id, name: s.data.name, color: s.data.color }))}
      audio={trip.audio}
    />
  </div>
</BaseLayout>
